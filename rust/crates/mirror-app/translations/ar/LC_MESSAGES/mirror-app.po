msgstr "إيقاف العرض"

msgid "Sound off — click to turn on"
msgstr "الصوت مغلق — اضغط للتشغيل"

msgid "Sound on PC — click to mute"
msgstr "الصوت على الكمبيوتر — اضغط للكتم"

msgid "Rotate view"
msgstr "تدوير العرض"

msgid "AUTO"
msgstr "تلقائي"

msgid "EDGE"
msgstr "ملء"

msgid "FILL"
msgstr "تمديد"

msgid "View mode: Auto-Fit / Edge-to-Edge / Stretch"
msgstr "وضع العرض: ملاءمة تلقائية / ملء الحواف / تمديد"

msgid "Exit full screen"
msgstr "الخروج من ملء الشاشة"

msgid "Full screen"
msgstr "ملء الشاشة"

msgid "Settings"
msgstr "الإعدادات"

msgid "Swipe from the right edge (forward)"
msgstr "سحب من الحافة اليمنى (للأمام)"

msgid "Swipe left"
msgstr "سحب لليسار"

msgid "Back (right click works too)"
msgstr "رجوع (الزر الأيمن يعمل أيضاً)"

msgid "Home screen"
msgstr "الشاشة الرئيسية"

msgid "Home"
msgstr "الرئيسية"

msgid "Recent apps"
msgstr "التطبيقات الأخيرة"

msgid "Recent"
msgstr "الأخيرة"

msgid "Swipe from the left edge (back, also Alt+←)"
msgstr "سحب من الحافة اليسرى (رجوع، أو Alt+←)"

msgid "Swipe right"
msgstr "سحب لليمين"

msgid "Control Center"
msgstr "مركز التحكم"

msgid "Control"
msgstr "التحكم"

msgid "Phone apps (open on the phone or in a new window)"
msgstr "تطبيقات الجوال (تُفتح على الجوال أو في نافذة جديدة)"

msgid "Apps"
msgstr "التطبيقات"

msgid "Quick Settings"
msgstr "الإعدادات السريعة"

msgid "Quick"
msgstr "سريعة"

msgid "Notifications"
msgstr "الإشعارات"

msgid "Alerts"
msgstr "الإشعارات"

msgid "Phone volume down"
msgstr "خفض صوت الجوال"

msgid "Phone volume up"
msgstr "رفع صوت الجوال"

msgid "Power button (lock / wake the screen)"
msgstr "زر التشغيل (قفل / إيقاظ الشاشة)"

msgid "Lock screen"
msgstr "قفل الشاشة"

msgid "Lock"
msgstr "قفل"

msgid "Needs Trust"
msgstr "يحتاج «الوثوق»"

msgid "Wi-Fi not set up"
msgstr "Wi-Fi غير مُعدّ"

msgid "Choose a mode"
msgstr "اختر وضعاً"

msgid "Needs a driver"
msgstr "يحتاج تعريفاً"

msgid "Restore the Apple driver"
msgstr "استعادة تعريف Apple"

msgid "Install the Studio mode driver"
msgstr "تثبيت تعريف وضع الاستوديو"

msgid "libusb-win32 is not installed"
msgstr "libusb-win32 غير مثبّت"

msgid "Remove the libusb0 filter first"
msgstr "أزل مرشّح libusb0 أولاً"

msgid "Choose a connection mode"
msgstr "اختر وضع الاتصال"

msgid "Wi-Fi is not set up yet"
msgstr "لم يُعدّ Wi-Fi بعد"

msgid "Unlock it and tap Trust"
msgstr "افتح قفله واضغط «الوثوق»"

msgid "This device uses the Studio mode driver, so Apple mode cannot see it. Restore the Apple driver, or switch to Studio mode."
msgstr "هذا الجهاز يستخدم تعريف وضع الاستوديو، لذلك لا يراه وضع Apple. استعد تعريف Apple أو انتقل إلى وضع الاستوديو."

msgid "Studio mode uses the libusb0 driver on the device. Install it, or switch to Apple Driver mode."
msgstr "وضع الاستوديو يستخدم تعريف libusb0 على الجهاز. ثبّته أو انتقل إلى وضع تعريف Apple."

msgid "Install the iOS driver of TikTok LIVE Studio or libusb-win32 once, then press Check drivers. Or use Apple Driver mode."
msgstr "ثبّت تعريف iOS الخاص بـ TikTok LIVE Studio أو libusb-win32 مرة واحدة، ثم اضغط «فحص التعريفات». أو استخدم وضع تعريف Apple."

msgid "A libusb0 filter is stacked on the Apple driver. It can crash Windows."
msgstr "يوجد مرشّح libusb0 فوق تعريف Apple، وقد يسبب تعطّل Windows."

msgid "Pick Apple Driver or Studio mode to continue."
msgstr "اختر تعريف Apple أو وضع الاستوديو للمتابعة."

msgid "Plug in the cable once, then press Set up Wi-Fi in Settings. Or choose Cable."
msgstr "وصّل الكيبل مرة واحدة، ثم اضغط «إعداد Wi-Fi» في الإعدادات. أو اختر الكيبل."

msgid "Unlock the device, tap Trust if it asks, then try again."
msgstr "افتح قفل الجهاز، واضغط «الوثوق» إن طُلب، ثم حاول مرة أخرى."

msgid "Detect device"
msgstr "اكتشاف الجهاز"

msgid "Found on USB through the libusb0 driver"
msgstr "تم العثور عليه عبر USB بتعريف libusb0"

msgid "Open the device"
msgstr "فتح الجهاز"

msgid "Switching it to its screen-capture mode"
msgstr "تحويله إلى وضع التقاط الشاشة"

msgid "Check trust"
msgstr "التحقق من الوثوق"

msgid "Keep it unlocked while 3zT Mirroring proves this PC is trusted"
msgstr "أبقِه مفتوح القفل بينما يتحقق 3zT Mirroring من أن هذا الكمبيوتر موثوق"

msgid "Start stream"
msgstr "بدء البث"

msgid "Receiving the screen over Studio mode"
msgstr "استقبال الشاشة عبر وضع الاستوديو"

msgid "Device connected"
msgstr "الجهاز متصل"

msgid "Your iPhone/iPad chose 3zT Mirroring in Screen Mirroring"
msgstr "اختار جهاز iPhone/iPad ‏3zT Mirroring في «انعكاس الشاشة»"

msgid "Secure connection"
msgstr "اتصال آمن"

msgid "AirPlay pairing and FairPlay key exchange"
msgstr "إقران AirPlay وتبادل مفاتيح FairPlay"

msgid "Receive video"
msgstr "استقبال الفيديو"

msgid "Decrypting the AirPlay stream"
msgstr "فك تشفير بث AirPlay"

msgid "Receiving the screen over Wi-Fi"
msgstr "استقبال الشاشة عبر Wi-Fi"

msgid "Found through Apple Mobile Device Service"
msgstr "تم العثور عليه عبر خدمة Apple Mobile Device"

msgid "Opening an encrypted Wi-Fi tunnel to the device"
msgstr "فتح نفق Wi-Fi مشفّر إلى الجهاز"

msgid "Opening an encrypted USB tunnel to the device"
msgstr "فتح نفق USB مشفّر إلى الجهاز"

msgid "Prepare the device"
msgstr "تجهيز الجهاز"

msgid "Keep it unlocked. The first time, a small developer image is installed."
msgstr "أبقِه مفتوح القفل. في المرة الأولى تُثبّت صورة مطوّر صغيرة."

msgid "Receiving the screen in HEVC"
msgstr "استقبال الشاشة بصيغة HEVC"

msgid "Ready · Wi-Fi"
msgstr "جاهز · Wi-Fi"

msgid "Waiting for the iPhone / iPad"
msgstr "بانتظار iPhone / iPad"

msgid "Plug in an iPhone or iPad"
msgstr "وصّل iPhone أو iPad"

msgid "{} ready"
msgstr "{} جاهز"

msgid "On the iPhone/iPad: open Control Center → Screen Mirroring → pick 3zT Mirroring. The PC and the device must be on the same network."
msgstr "على iPhone/iPad: افتح مركز التحكم ← انعكاس الشاشة ← اختر 3zT Mirroring. يجب أن يكون الكمبيوتر والجهاز على الشبكة نفسها."

msgid "On the iPhone/iPad: Control Center → Screen Mirroring → 3zT Mirroring."
msgstr "على iPhone/iPad: مركز التحكم ← انعكاس الشاشة ← 3zT Mirroring."

msgid "Wi-Fi: the PC and the device on the same network. The first time, press Set up Wi-Fi in Settings with the cable in."
msgstr "Wi-Fi: الكمبيوتر والجهاز على الشبكة نفسها. في المرة الأولى اضغط «إعداد Wi-Fi» في الإعدادات والكيبل موصول."

msgid "Use a USB cable, unlock it and tap Trust."
msgstr "استخدم كيبل USB، وافتح القفل واضغط «الوثوق»."

msgid "Unlock it, then press Start mirroring."
msgstr "افتح القفل، ثم اضغط «ابدأ العرض»."

msgid "Studio mode"
msgstr "وضع الاستوديو"

msgid "Apple Driver"
msgstr "تعريف Apple"

msgid "Change"
msgstr "تغيير"

msgid "Choose Apple Driver or Studio mode"
msgstr "اختر تعريف Apple أو وضع الاستوديو"

msgid "Cable (USB)"
msgstr "كيبل (USB)"

msgid "Stop waiting"
msgstr "إيقاف الانتظار"

msgid "Restore Apple driver"
msgstr "استعادة تعريف Apple"

msgid "Install driver"
msgstr "تثبيت التعريف"

msgid "Remove filter"
msgstr "إزالة المرشّح"

msgid "Choose mode"
msgstr "اختر الوضع"

msgid "Open settings"
msgstr "فتح الإعدادات"

msgid "Couldn't connect"
msgstr "تعذّر الاتصال"

msgid "Connected"
msgstr "متصل"

msgid "Connecting to {}"
msgstr "جارٍ الاتصال بـ {}"

msgid "Connecting"
msgstr "جارٍ الاتصال"

msgid "How should 3zT Mirroring connect?"
msgstr "كيف يتصل 3zT Mirroring؟"

msgid "Nothing connects and no driver changes until you continue."
msgstr "لن يتصل شيء ولن يتغير أي تعريف حتى تتابع."

msgid "Cancel"
msgstr "إلغاء"

msgid "Standard · full control"
msgstr "قياسي · تحكم كامل"

msgid "Recommended"
msgstr "موصى به"

msgid "Uses Apple's own driver. Most compatible, stable and easy."
msgstr "يستخدم تعريف Apple نفسه. الأكثر توافقاً وثباتاً وسهولة."

msgid "Up to 60 fps, HEVC (device-limited bitrate, about 4–6 Mbps)"
msgstr "حتى 60 إطاراً/ث، HEVC (معدل بت يحدده الجهاز، نحو 4–6 Mbps)"

msgid "Mouse touch, keyboard, gestures and buttons"
msgstr "لمس بالماوس، لوحة مفاتيح، إيماءات وأزرار"

msgid "Apple's own driver, nothing to install"
msgstr "تعريف Apple نفسه، لا شيء للتثبيت"

msgid "Cable or Wi-Fi (after a one-time setup with the cable)"
msgstr "كيبل أو Wi-Fi (بعد إعداد لمرة واحدة بالكيبل)"

msgid "iOS 17–26: Hybrid Control (experimental)"
msgstr "iOS 17–26: تحكم هجين (تجريبي)"

msgid "iOS 16 or older: use Studio mode"
msgstr "iOS 16 أو أقدم: استخدم وضع الاستوديو"

msgid "For live streaming"
msgstr "للبث المباشر"

msgid "Best quality for streaming: high bitrate (measured 12–30 Mbps), up to 60 fps, very low latency. Needs the libusb0 driver."
msgstr "أفضل جودة للبث: معدل بت عالٍ (مقاس 12–30 Mbps)، حتى 60 إطاراً/ث، وتأخير منخفض جداً. يحتاج تعريف libusb0."

msgid "Up to 60 fps, full native resolution over the cable, high-bitrate H.264"
msgstr "حتى 60 إطاراً/ث، الدقة الأصلية كاملة عبر الكيبل، H.264 بمعدل بت عالٍ"

msgid "Cable (USB) or Wi-Fi (AirPlay, no driver)"
msgstr "كيبل (USB) أو Wi-Fi (‏AirPlay، بلا تعريف)"

msgid "Picture and sound only: no touch, keyboard or gestures"
msgstr "صورة وصوت فقط: بلا لمس أو لوحة مفاتيح أو إيماءات"

msgid "Apple apps can't see the device until you switch back"
msgstr "تطبيقات Apple لا ترى الجهاز حتى تعود"

msgid "Connection"
msgstr "الاتصال"

msgid "Cable"
msgstr "كيبل"

msgid "Remember my choice"
msgstr "تذكّر اختياري"

msgid "You can change it any time in Settings › Connection & driver. Changing it may need an app restart and reconnecting the cable."
msgstr "يمكنك تغييره في أي وقت من الإعدادات › الاتصال والتعريف. قد يحتاج التغيير إلى إعادة تشغيل التطبيق وإعادة توصيل الكيبل."

msgid "Change device type"
msgstr "تغيير نوع الجهاز"

msgid "Continue"
msgstr "متابعة"

msgid "Detected"
msgstr "تم اكتشافه"

msgid "{} detected"
msgstr "تم اكتشاف {}"

msgid "Mirror and control compatible Apple devices using USB or Wi-Fi."
msgstr "اعرض أجهزة Apple المتوافقة وتحكم بها عبر USB أو Wi-Fi."

msgid "Android Smartphone / Tablet"
msgstr "جوال / تابلت Android"

msgid "High-performance Android mirroring and control over USB or Wi-Fi."
msgstr "عرض وتحكم عالي الأداء لأجهزة Android عبر USB أو Wi-Fi."

msgid "Apple Driver or Studio mode"
msgstr "تعريف Apple أو وضع الاستوديو"

msgid "Cable or Wi-Fi"
msgstr "كيبل أو Wi-Fi"

msgid "Through ADB and scrcpy, no app on the phone"
msgstr "عبر ADB وscrcpy، بلا تطبيق على الجوال"

msgid "Cable or Wi-Fi, any Android brand"
msgstr "كيبل أو Wi-Fi، أي نوع Android"

msgid "Welcome to 3zT Mirroring"
msgstr "مرحباً بك في 3zT Mirroring"

msgid "Which device would you like to connect?"
msgstr "أي جهاز تريد توصيله؟"

msgid "iPhone / iPad"
msgstr "iPhone / iPad"

msgid "Apple and Android devices are both connected. Choose the one to mirror."
msgstr "جهاز Apple وجهاز Android متصلان معاً. اختر الذي تريد عرضه."

msgid "Remember device type"
msgstr "تذكّر نوع الجهاز"

msgid "You can change it any time in Settings › Device type or with the Back button."
msgstr "يمكنك تغييره في أي وقت من الإعدادات › نوع الجهاز أو بزر الرجوع."

msgid "Android video"
msgstr "فيديو Android"

msgid "A profile fills in resolution, FPS, bitrate and codec; change one value and the profile becomes Custom. Each phone keeps its own settings (the same over USB and Wi-Fi). Encoders are read from the phone on the first mirroring; if the chosen encoder fails, 3zT Mirroring tries another hardware encoder, then H.264, at most 4 times, and keeps your choice."
msgstr "الملف الشخصي يضبط الدقة ومعدل الإطارات ومعدل البت والترميز؛ غيّر أي قيمة ويصبح «مخصص». لكل جوال إعداداته (نفسها عبر USB وWi-Fi). تُقرأ المرمّزات من الجوال في أول عرض؛ إذا فشل المرمّز المختار يجرب 3zT Mirroring مرمّزاً عتادياً آخر ثم H.264، أربع مرات كحد أقصى، ويحتفظ باختيارك."

msgid "Profile"
msgstr "الملف"

msgid "Low Latency"
msgstr "تأخير منخفض"

msgid "Balanced"
msgstr "متوازن"

msgid "High Quality"
msgstr "جودة عالية"

msgid "Streaming"
msgstr "بث"

msgid "Custom"
msgstr "مخصص"

msgid "Resolution"
msgstr "الدقة"

msgid "Longest side."
msgstr "الضلع الأطول."

msgid "Native"
msgstr "الأصلية"

msgid "FPS"
msgstr "الإطارات/ث"

msgid "A cap; the phone never goes above its refresh rate."
msgstr "حد أعلى؛ لا يتجاوز الجوال معدل تحديث شاشته."

msgid "Bitrate"
msgstr "معدل البت"

msgid "Codec"
msgstr "الترميز"

msgid "H.265 needs HEVC Video Extensions on Windows."
msgstr "H.265 يحتاج امتداد HEVC Video Extensions في Windows."

msgid "This phone has no H.265 encoder."
msgstr "هذا الجوال لا يملك مرمّز H.265."

msgid "Auto = H.264, the lowest latency."
msgstr "تلقائي = H.264، أقل تأخير."

msgid "Encoder"
msgstr "المرمّز"

msgid "Detected on the first mirroring."
msgstr "يُكتشف في أول عرض."

msgid "In use"
msgstr "المستخدم الآن"

msgid "Switch to Wi-Fi: once connected, you can unplug the cable"
msgstr "التحويل إلى Wi-Fi: بعد الاتصال يمكنك فصل الكيبل"

msgid "Start mirroring this device"
msgstr "ابدأ عرض هذا الجهاز"

msgid "Start over the USB cable (most stable, lowest delay)"
msgstr "ابدأ عبر كيبل USB (الأكثر ثباتاً وأقل تأخير)"

msgid "Start over Wi-Fi (you can unplug the cable)"
msgstr "ابدأ عبر Wi-Fi (يمكنك فصل الكيبل)"

msgid "Connecting… the phone starts the scrcpy server."
msgstr "جارٍ الاتصال… الجوال يشغّل خادم scrcpy."

msgid "Working…"
msgstr "جارٍ العمل…"

msgid "Connect over Wi-Fi"
msgstr "الاتصال عبر Wi-Fi"

msgid "Scan a QR code, a pairing code or an IP:port address"
msgstr "امسح رمز QR، أو رمز إقران، أو عنوان IP:port"

msgid "Already on the cable? Press the Wi-Fi button next to the phone's name, done. Without a cable (Android 11+):"
msgstr "موصول بالكيبل؟ اضغط زر Wi-Fi بجانب اسم الجوال وانتهى. بدون كيبل (Android 11+):"

msgid "Option 1 · Scan a QR code (easiest)"
msgstr "الخيار 1 · امسح رمز QR (الأسهل)"

msgid "The phone and the PC are on the same Wi-Fi."
msgstr "الجوال والكمبيوتر على شبكة Wi-Fi نفسها."

msgid "On the phone: Settings › Developer options › Wireless debugging › turn it on."
msgstr "على الجوال: الإعدادات › خيارات المطور › تصحيح الأخطاء اللاسلكي › فعّله."

msgid "Press the button below, then on the phone tap \"Pair device with QR code\" and scan."
msgstr "اضغط الزر أدناه، ثم على الجوال اضغط «إقران الجهاز باستخدام رمز QR» وامسح."

msgid "Show QR code"
msgstr "عرض رمز QR"

msgid "Show a QR code to scan on the phone"
msgstr "عرض رمز QR لمسحه بالجوال"

msgid "On the phone: Wireless debugging › \"Pair device with QR code\", then scan this code."
msgstr "على الجوال: تصحيح الأخطاء اللاسلكي › «إقران الجهاز باستخدام رمز QR»، ثم امسح هذا الرمز."

msgid "Option 2 · Pairing code or IP address"
msgstr "الخيار 2 · رمز إقران أو عنوان IP"

msgid "Hide"
msgstr "إخفاء"

msgid "Show"
msgstr "إظهار"

msgid "In Wireless debugging, tap \"Pair device with pairing code\"."
msgstr "في تصحيح الأخطاء اللاسلكي اضغط «إقران الجهاز باستخدام رمز الإقران»."

msgid "Enter the IP:port and the 6-digit code shown in that window, press Pair."
msgstr "أدخل IP:port والرمز المكوّن من 6 أرقام الظاهرين في تلك النافذة، ثم اضغط «إقران»."

msgid "Enter the IP:port from the main Wireless debugging screen (a different port), press Connect. Paired before? Go straight to step 3."
msgstr "أدخل IP:port من شاشة تصحيح الأخطاء اللاسلكي الرئيسية (منفذ مختلف)، ثم اضغط «اتصال». أقرنته من قبل؟ انتقل مباشرة إلى الخطوة 3."

msgid "IP:port, e.g. 192.168.1.20:37099"
msgstr "IP:port، مثل 192.168.1.20:37099"

msgid "6-digit code"
msgstr "رمز من 6 أرقام"

msgid "Pair"
msgstr "إقران"

msgid "Step 2: pair once with the code from the phone"
msgstr "الخطوة 2: أقرن مرة واحدة بالرمز من الجوال"

msgid "Connect"
msgstr "اتصال"

msgid "Step 3: connect to this address (adb connect)"
msgstr "الخطوة 3: الاتصال بهذا العنوان (adb connect)"

msgid "Turn on USB debugging"
msgstr "فعّل تصحيح أخطاء USB"

msgid "Settings › About phone › tap Build number 7×, then Developer options › USB debugging."
msgstr "الإعدادات › حول الهاتف › اضغط «رقم الإصدار» 7 مرات، ثم خيارات المطور › تصحيح أخطاء USB."

msgid "Plug in the USB cable"
msgstr "وصّل كيبل USB"

msgid "Use a data cable, not a charge-only cable."
msgstr "استخدم كيبل بيانات، وليس كيبل شحن فقط."

msgid "Allow it on the phone"
msgstr "اسمح به على الجوال"

msgid "Tap Allow on the Allow USB debugging prompt."
msgstr "اضغط «سماح» في نافذة السماح بتصحيح أخطاء USB."

msgid "Beta: picture, sound (Android 11+) and control from the PC. No driver is installed or changed."
msgstr "تجريبي: صورة وصوت (Android 11+) وتحكم من الكمبيوتر. لا يُثبّت أو يُغيّر أي تعريف."

msgid "Settings & controls"
msgstr "الإعدادات وأدوات التحكم"

msgid "Appearance"
msgstr "المظهر"

