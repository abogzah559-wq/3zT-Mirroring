msgstr "إعادة تشغيل"

msgid "Restart the connection"
msgstr "إعادة تشغيل الاتصال"

msgid "Start"
msgstr "ابدأ"

msgid "Start mirroring"
msgstr "ابدأ العرض"

msgid "Stop"
msgstr "إيقاف"

