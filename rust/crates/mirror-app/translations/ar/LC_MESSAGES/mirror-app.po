msgstr "استعادة"

msgid "Maximise"
msgstr "تكبير"

msgid "Buy me a coffee"
msgstr "اشترِ لي قهوة"

msgid "Updating {}%"
msgstr "جارٍ التحديث {}%"

msgid "Updating…"
msgstr "جارٍ التحديث…"

msgid "Update to v{}"
msgstr "تحديث إلى v{}"

msgid "Mirroring"
msgstr "يعرض الآن"

