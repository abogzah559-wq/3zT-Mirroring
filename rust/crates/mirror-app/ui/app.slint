// 3zT Mirroring main window. Same idea as v2: header with the everyday actions,
// the picture, a shortcut bar under it, and Settings docked at the side.
// The window hugs the picture; opening Settings widens it, closing shrinks it.

import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Glass, Icon, GlassButton, Seg, Toggle, GlassSlider, Row, Card, Chip, Tip, UiTest } from "widgets.slint";
// an Android app in its own window (3zTMirroring.exe --android-app).
export { AppWin } from "appwin.slint";

export { Theme, UiTest }

// Smart Encoder Detection results for the selected Android device,
// filled from Rust.
export global AndroidEnc {
    // Encoder choices for the selected codec: "" = Auto, then MediaCodec names.
    in property <[string]> options: [""];
    in property <[string]> labels: [@tr("Auto")];
    // Codecs both ends support (empty = not detected yet).
    in property <[string]> codecs;
    // e.g. "H.264: 2 (1 hw) · H.265: 1 (1 hw)".
    in property <string> detected;
    // What the running session uses, e.g. "H.264 · c2.qti.avc.encoder".
    in property <string> using;
}

export struct Prefs {
    theme: string,          // light | dark | system
    glass-on: bool,         // Liquid Glass on; off = solid window
    glass: float,           // thickness 0..100: 0 = fully clear, 100 = thick frosted
    lens: bool,             // refraction / lensing layer
    fit: string,            // contain | cover | fill
    fit-window: bool,
    rotation: string,       // auto | 0 | 90 | 180 | 270
    crop-l: float, crop-t: float, crop-r: float, crop-b: float,
    audio-out: string,      // pc | device
    volume: float,
    lip-sync: bool,
    audio-buffer: string,   // low | normal | high
    touch: bool,
    keyboard: bool,
    gestures: bool,
    start-with-windows: bool,
    close-to-tray: bool,
    auto-unlock: bool,
    on-top: bool,
    stats: bool,
    dots: bool,             // animated dot background
    platform: string,       // "" | apple | android (first screen)
    remember-platform: bool,
    android-max-size: string, // 1280 | 1920 | 2560 | 0 (native), longest side
    android-fps: string,      // 30 | 60 | 90 | 120 | 144 (cap)
    android-bitrate: string,  // Mbps: 4 | 8 | 16 | 24 | 40
    android-codec: string,    // auto | h264 | h265
    android-profile: string,  // low-latency | balanced | high-quality | streaming | custom
    android-encoder: string,  // "" = automatic, else a MediaCodec name from the phone's list
    update-check: bool,       // look for a new version at start
    update-channel: string,   // "" = this build's own | stable | beta
    language: string,         // "" = as Windows | en | ar
}

// Window controls in the macOS style: close, minimise, zoom. The symbols
// show while the pointer is over the group.
component TrafficLights inherits HorizontalLayout {
    callback act(string);
    in property <bool> maximized;
    property <bool> hot: false;
    spacing: 8px;
    alignment: center;
    for b in [
        { id: "close", c: #ff5f57, g: "\u{E8BB}" },
        { id: "min", c: #febc2e, g: "\u{E921}" },
        { id: "max", c: #28c840, g: "\u{E922}" },
    ]: Rectangle {
        width: 13px;
        height: 13px;
        y: (parent.height - self.height) / 2;
        border-radius: 6.5px;
        background: ta.pressed ? b.c.darker(25%) : b.c;
        border-width: 0.5px;
        border-color: #00000040;
        Text {
            visible: root.hot;
            text: b.id == "max" && root.maximized ? "\u{E923}" : b.g;
            font-family: Theme.icons;
            font-size: 7px;
            color: #000000a6;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { Tip.shown = false; root.act(b.id); }
            changed has-hover => {
                root.hot = self.has-hover;
                if self.has-hover {
                    Tip.text = b.id == "min" ? @tr("Minimise") : b.id == "close" ? @tr("Close")
                        : root.maximized ? @tr("Restore") : @tr("Maximise");
                    Tip.x = self.absolute-position.x + self.width / 2;
                    Tip.top = self.absolute-position.y;
                    Tip.bottom = self.absolute-position.y + self.height;
                    Tip.shown = true;
                } else {
                    Tip.shown = false;
                }
            }
        }
    }
}

// "Buy me a coffee": a small pill next to the window controls. The width
// comes from the content; the cup's drawing sits left of its 24-unit box
// (the handle is on the right), so the paddings even out what the eye sees.
component CoffeeButton inherits Rectangle {
    callback clicked();
    in property <bool> compact;
    width: row.preferred-width;
    height: 26px;
    border-radius: 13px;
    background: ta.pressed ? Theme.fill-hover : ta.has-hover ? Theme.fill : Theme.raise;
    border-width: 1px;
    border-color: Theme.line;
    animate background { duration: 120ms; }
    row := HorizontalLayout {
        padding-left: root.compact ? 6px : 10px;
        padding-right: root.compact ? 5px : 12px;
        spacing: 6px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Path {
                width: 15px;
                height: 15px;
                viewbox-width: 24;
                viewbox-height: 24;
                stroke: Theme.text;
                stroke-width: 1.6px;
                fill: transparent;
                commands: "M4 9 L16 9 L16 14 A5 5 0 0 1 11 19 L9 19 A5 5 0 0 1 4 14 Z M16 10.5 L17.5 10.5 A2.5 2.5 0 0 1 17.5 15.5 L16 15.5 M8 3.5 C7.2 4.5 8.8 5.5 8 6.5 M12 3.5 C11.2 4.5 12.8 5.5 12 6.5";
            }
        }
        if !root.compact: Text {
            text: @tr("Buy me a coffee");
            font-size: 11.5px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { Tip.shown = false; root.clicked(); }
        changed has-hover => {
            if self.has-hover && root.compact {
                Tip.text = @tr("Buy me a coffee");
                Tip.x = self.absolute-position.x + self.width / 2;
                Tip.top = self.absolute-position.y;
                Tip.bottom = self.absolute-position.y + self.height;
                Tip.shown = true;
            } else {
                Tip.shown = false;
            }
        }
    }
}

// "Update available": a small pill in the header; one click downloads,
// verifies and installs the new version.
component UpdatePill inherits Rectangle {
    callback clicked();
    in property <string> version;
    in property <bool> busy;
    in property <float> progress: -1;
    width: t.preferred-width + 22px;
    height: 24px;
    border-radius: 12px;
    background: ta.has-hover && !busy ? Theme.btn-hover : Theme.btn;
    clip: true;
    if progress >= 0: Rectangle {
        x: 0;
        width: parent.width * clamp(progress, 0, 1);
        height: parent.height;
        background: #00000026;
        animate width { duration: 120ms; }
    }
    t := Text {
        text: busy ? (progress >= 0 ? @tr("Updating {}%", round(progress * 100)) : @tr("Updating…")) : @tr("Update to v{}", root.version);
        font-size: 11px;
        font-weight: 700;
        color: Theme.btn-text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        mouse-cursor: root.busy ? MouseCursor.default : MouseCursor.pointer;
        clicked => { if !root.busy { root.clicked(); } }
    }
}

// The window's own header: no card of its own, it is the top of the glass
// window (no header-inside-a-header).
component TopBar inherits Rectangle {
    in property <string> device;
    in property <string> phase;
    in property <string> link;
    in property <string> stats;
    in property <bool> settings-open;
    in property <bool> muted;
    callback start();
    callback stop();
    callback restart();
    callback settings();
    callback mute();
    callback rotate();
    callback fit-next();
    callback window-action(string);
    in property <string> fit;
    in property <bool> compact;
    in property <bool> maximized;
    in property <bool> fullscreen;
    property <bool> live: phase == "streaming";
    in property <string> need; // the device needs something before Start ("" = ready)
    property <bool> blocked: !live && phase != "connecting" && phase != "activating" && device != "" && need != "";
    property <bool> busy: phase == "connecting" || phase == "activating";
    // AirPlay receiver on, waiting for the device to pick it.
    in property <bool> listening;
    // Update offer ("" = none) and its download progress.
    in property <string> upd-version;
    in property <bool> upd-busy;
    in property <float> upd-progress: -1;
    callback update-now();
    height: 46px;
    // Empty header space moves the window; double-click maximises.
    TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.window-action("drag");
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 6px;
        alignment: stretch;
        TrafficLights {
            maximized: root.maximized;
            act(a) => { root.window-action(a); }
        }
        Rectangle { width: 4px; }
        VerticalLayout {
            alignment: center;
            CoffeeButton {
                compact: root.compact;
                clicked => { root.window-action("coffee"); }
            }
        }
        Rectangle { width: 2px; }
        // App identity: always visible, the wordmark only when there is room.
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../../../assets/logo-256.png");
                width: 24px;
                height: 24px;
            }
        }
        Text {
            text: "3zT Mirroring";
            font-size: 14px;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        if root.upd-version != "": VerticalLayout {
            alignment: center;
            UpdatePill {
                version: root.upd-version;
                busy: root.upd-busy;
                progress: root.upd-progress;
                clicked => { root.update-now(); }
            }
        }
        // Status: a dot when narrow (name in its tooltip), a pill otherwise.
        if compact: VerticalLayout {
          alignment: center;
          Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: live ? Theme.accent : busy || blocked ? #f59e0b : #22c55e;
            border-width: 2px;
            border-color: Theme.dark ? #ffffff33 : #ffffffcc;
          }
        }
        if !compact: VerticalLayout {
          alignment: center;
          Rectangle {
            width: pillT.preferred-width + 16px;
            height: 24px;
            border-radius: 12px;
            background: live ? Theme.accent-soft : Theme.raise;
            border-width: 1px;
            border-color: Theme.line;
            pillT := Text {
                text: live ? @tr("Mirroring") : listening ? @tr("Waiting for the device") : busy ? @tr("Connecting…") : blocked ? @tr("Action needed") : @tr("Ready");
                font-size: 11px;
                font-weight: 600;
                color: live ? Theme.accent : Theme.text-2;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
          }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            if !compact: Text {
                text: device == "" ? @tr("No device") : device + (link == "" ? "" : "  ·  " + link);
                font-size: 11.5px;
                color: Theme.text-2;
                overflow: elide;
            }
            if stats != "": Text { text: stats; font-size: 10.5px; color: Theme.text-3; overflow: elide; font-family: "Cascadia Mono"; }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E72C}";
            label: compact ? "" : @tr("Restart");
            tip: @tr("Restart the connection");
            clicked => { root.restart(); }
        }
        if !live && !busy: GlassButton {
            y: (parent.height - self.height) / 2;
            primary: true;
            icon: "\u{E768}";
            label: compact ? "" : @tr("Start");
            tip: @tr("Start mirroring");
            clicked => { root.start(); }
        }
        if live || busy: GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E71A}";
            label: compact ? "" : @tr("Stop");
            tip: @tr("Stop mirroring");
            clicked => { root.stop(); }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: muted ? "\u{E74F}" : "\u{E767}";
            tip: muted ? @tr("Sound off — click to turn on") : @tr("Sound on PC — click to mute");
            active: !muted;
            clicked => { root.mute(); }
        }
        if !compact: GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E7AD}";
            clicked => { root.rotate(); }
            tip: @tr("Rotate view");
        }
        if !compact: GlassButton {
            y: (parent.height - self.height) / 2;
            label: fit == "contain" ? @tr("AUTO") : fit == "cover" ? @tr("EDGE") : @tr("FILL");
            tip: @tr("View mode: Auto-Fit / Edge-to-Edge / Stretch");
            active: true;
            clicked => { root.fit-next(); }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: root.fullscreen ? "\u{E73F}" : "\u{E740}";
            active: root.fullscreen;
            tip: root.fullscreen ? @tr("Exit full screen") : @tr("Full screen");
            clicked => { root.window-action("fullscreen"); }
        }
        GlassButton {
            y: (parent.height - self.height) / 2;
            icon: "\u{E713}";
            active: settings-open;
            tip: @tr("Settings");
            clicked => { root.settings(); }
        }
    }
}

// 3zT Mirroring dock: a floating glass capsule centred under the picture,
// only as wide as its buttons (scrolls when the window is narrower).
component BottomBar inherits Rectangle {
    callback action(string);
    in property <bool> compact;
    // Android: its own buttons (Back, Home, Recents, panels, volume, power).
    in property <bool> android;
    height: 46px;
    dock := Glass {
        width: min(root.width, row.min-width);
        x: (root.width - self.width) / 2;
        height: root.height;
        border-radius: self.height / 2;
        fl := Flickable {
            content-width: max(self.width, row.min-width);
            interactive: row.min-width > self.width;
            row := HorizontalLayout {
                width: fl.content-width;
                height: dock.height;
                padding: 7px;
                padding-left: 9px;
                padding-right: 9px;
                spacing: 6px;
                alignment: center;
                if !root.android: Chip { icon: "\u{E76B}"; tip: @tr("Swipe from the right edge (forward)"); label: compact ? "" : @tr("Swipe left"); clicked => { root.action("swipe-left"); } }
                if root.android: Chip { icon: "\u{E72B}"; tip: @tr("Back (right click works too)"); label: compact ? "" : @tr("Back"); clicked => { root.action("back"); } }
                Chip { icon: "\u{E80F}"; tip: @tr("Home screen"); label: compact ? "" : @tr("Home"); clicked => { root.action("home"); } }
                Chip { icon: "\u{E8A9}"; tip: @tr("Recent apps"); label: compact ? "" : @tr("Recent"); clicked => { root.action("switcher"); } }
                if !root.android: Chip { icon: "\u{E76C}"; tip: @tr("Swipe from the left edge (back, also Alt+←)"); label: compact ? "" : @tr("Swipe right"); clicked => { root.action("swipe-right"); } }
                Rectangle { width: 1px; background: Theme.dark ? #ffffff1f : #0000001a; }
                if !root.android: Chip { icon: "\u{E9E9}"; tip: @tr("Control Center"); label: compact ? "" : @tr("Control"); clicked => { root.action("control-center"); } }
                if root.android: Chip { icon: "\u{E71D}"; tip: @tr("Phone apps (open on the phone or in a new window)"); label: compact ? "" : @tr("Apps"); clicked => { root.action("apps"); } }
                if root.android: Chip { icon: "\u{E9E9}"; tip: @tr("Quick Settings"); label: compact ? "" : @tr("Quick"); clicked => { root.action("quick-settings"); } }
                Chip { icon: "\u{EA8F}"; tip: @tr("Notifications"); label: compact ? "" : @tr("Alerts"); clicked => { root.action("notifications"); } }
                if root.android: Chip { icon: "\u{E993}"; tip: @tr("Phone volume down"); label: ""; clicked => { root.action("vol-down"); } }
                if root.android: Chip { icon: "\u{E995}"; tip: @tr("Phone volume up"); label: ""; clicked => { root.action("vol-up"); } }
                Chip { icon: "\u{E72E}"; tip: root.android ? @tr("Power button (lock / wake the screen)") : @tr("Lock screen"); label: compact ? "" : @tr("Lock"); clicked => { root.action("lock"); } }
            }
        }
    }
}

// One iPhone/iPad in the Apple device list: connected now, or trusted
// before and not connected ("offline").
export struct AppleDev {
    id: string,
    title: string,
    sub: string,
    // "ready" | "need" | "offline"
    state: string,
    wifi: bool,
    selected: bool,
}

// One step of the connect card (done / active / todo / failed).
component FlowStep inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <string> state; // "done" | "active" | "todo" | "failed"
    in property <bool> last;
    property <color> c: state == "done" ? Theme.ok : state == "active" ? #f0b43c : state == "failed" ? #ff6961 : Theme.text-3;
    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: state == "done" || state == "failed" ? c : transparent;
            border-width: state == "done" || state == "failed" ? 0px : 1.5px;
            border-color: state == "active" ? c.with-alpha(0.35) : c.with-alpha(0.5);
            if state == "done" || state == "failed": Text {
                text: state == "done" ? "\u{E73E}" : "\u{E711}";
                font-family: Theme.icons;
                font-size: 11px;
                color: #101010;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Spinning arc while this step runs.
            if state == "active": Path {
                width: 22px;
                height: 22px;
                viewbox-width: 22;
                viewbox-height: 22;
                stroke: c;
                stroke-width: 2px;
                commands: "M 11 1.5 A 9.5 9.5 0 0 1 20.5 11";
                transform-rotation: (animation-tick() / 900ms) * 360deg;
            }
        }
        VerticalLayout {
            spacing: 3px;
            Text { text: title; font-size: 13.5px; font-weight: 600; color: state == "todo" ? Theme.text-3 : state == "active" ? c : Theme.text; }
            Text { text: sub; font-size: 11.5px; color: state == "active" ? Theme.text : Theme.text-3; wrap: word-wrap; }
        }
    }
    if !last: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
}

// Shown in the stage while there is no picture: the device ready to start
// (phone, cable, name), then the 1-2-3-4 connect card.
component Placeholder inherits Rectangle {
    in property <string> phase;
    in property <string> device;
    in property <string> message;
    // Connect card: step -1 = hidden, 0..4; kind "apple" | "usbdirect" | "airplay".
    in property <int> flow-step: -1;
    in property <bool> flow-failed;
    in property <string> flow-kind: "apple";
    in property <bool> wifi;
    // What stands between the device and Start ("" = ready): restore, bind,
    // package, removefilter, mode, wifi, trust.
    in property <string> need;
    // Connection mode ("apple" | "usbdirect" | "") and link ("wired" | "wireless"),
    // switchable right here like in Settings > Connection & driver.
    in property <string> mode;
    in property <string> link: "wired";
    // Connected and saved devices; a click picks the one Start uses.
    in property <[AppleDev]> devices;
    // AirPlay receiver on (Studio mode Wi-Fi): waiting for the device.
    in property <bool> listening;
    callback pick(string);
    callback forget(string);
    callback stop();
    callback start();
    callback dismiss();
    callback fix();
    callback set-link(string);
    callback change-mode();
    property <bool> card: flow-step >= 0;
    property <bool> air: link == "wireless";
    property <color> tone: device == "" ? Theme.text-3 : need != "" ? Theme.warn : Theme.ok;
    property <string> need-label: need == "trust" ? @tr("Needs Trust")
        : need == "wifi" ? @tr("Wi-Fi not set up")
        : need == "mode" ? @tr("Choose a mode")
        : @tr("Needs a driver");
    property <string> need-title: need == "restore" ? @tr("Restore the Apple driver")
        : need == "bind" ? @tr("Install the Studio mode driver")
        : need == "package" ? @tr("libusb-win32 is not installed")
        : need == "removefilter" ? @tr("Remove the libusb0 filter first")
        : need == "mode" ? @tr("Choose a connection mode")
        : need == "wifi" ? @tr("Wi-Fi is not set up yet")
        : @tr("Unlock it and tap Trust");
    property <string> need-hint: need == "restore" ? @tr("This device uses the Studio mode driver, so Apple mode cannot see it. Restore the Apple driver, or switch to Studio mode.")
        : need == "bind" ? @tr("Studio mode uses the libusb0 driver on the device. Install it, or switch to Apple Driver mode.")
        : need == "package" ? @tr("Install the iOS driver of TikTok LIVE Studio or libusb-win32 once, then press Check drivers. Or use Apple Driver mode.")
        : need == "removefilter" ? @tr("A libusb0 filter is stacked on the Apple driver. It can crash Windows.")
        : need == "mode" ? @tr("Pick Apple Driver or Studio mode to continue.")
        : need == "wifi" ? @tr("Plug in the cable once, then press Set up Wi-Fi in Settings. Or choose Cable.")
        : @tr("Unlock the device, tap Trust if it asks, then try again.");
    property <[[string]]> texts: flow-kind == "usbdirect" ? [
            [@tr("Detect device"), @tr("Found on USB through the libusb0 driver")],
            [@tr("Open the device"), @tr("Switching it to its screen-capture mode")],
            [@tr("Check trust"), @tr("Keep it unlocked while 3zT Mirroring proves this PC is trusted")],
            [@tr("Start stream"), @tr("Receiving the screen over Studio mode")]]
        : flow-kind == "airplay" ? [
            [@tr("Device connected"), @tr("Your iPhone/iPad chose 3zT Mirroring in Screen Mirroring")],
            [@tr("Secure connection"), @tr("AirPlay pairing and FairPlay key exchange")],
            [@tr("Receive video"), @tr("Decrypting the AirPlay stream")],
            [@tr("Start stream"), @tr("Receiving the screen over Wi-Fi")]]
        : [
            [@tr("Detect device"), @tr("Found through Apple Mobile Device Service")],
            [@tr("Secure connection"), wifi ? @tr("Opening an encrypted Wi-Fi tunnel to the device") : @tr("Opening an encrypted USB tunnel to the device")],
            [@tr("Prepare the device"), @tr("Keep it unlocked. The first time, a small developer image is installed.")],
            [@tr("Start stream"), @tr("Receiving the screen in HEVC")]];
    property <float> pct: max(0, min(flow-step, 4)) / 4;
    animate pct { duration: 420ms; easing: ease-out; }
    function st(i: int) -> string {
        if flow-failed && i == max(flow-step, 0) { return "failed"; }
        if i < flow-step { return "done"; }
        if i == flow-step { return "active"; }
        return "todo";
    }

    // Ready / plug-in view.
    if !card: VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding-left: 24px;
        padding-right: 24px;
        Rectangle {
            height: 196px;
            // Phone outline with its cable.
            Rectangle {
                x: (parent.width - 86px) / 2;
                y: 0px;
                width: 86px;
                height: 160px;
                border-radius: 18px;
                border-width: 2px;
                border-color: root.tone;
                background: Theme.dark ? #ffffff08 : #ffffff80;
                Rectangle { y: 8px; width: 26px; height: 6px; border-radius: 3px; background: root.tone; opacity: 0.6; }
            }
            if !wifi && !air: Rectangle {
                x: (parent.width - 2px) / 2;
                y: 160px;
                width: 2px;
                height: 36px;
                background: device == "" ? Theme.text-3.with-alpha(0.5) : root.tone;
            }
        }
        if device != "" && devices.length == 0 && !listening: HorizontalLayout {
            alignment: center;
            Rectangle {
                height: 28px;
                border-radius: 14px;
                background: Theme.dark ? #ffffff0d : #ffffffa0;
                border-width: 1px;
                border-color: root.tone.with-alpha(0.45);
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 14px;
                    spacing: 8px;
                    alignment: center;
                    VerticalLayout {
                        alignment: center;
                        Rectangle { width: 7px; height: 7px; border-radius: 3.5px; background: root.tone; }
                    }
                    Text { text: device; font-size: 12px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                    Text { text: "·"; color: Theme.text-3; vertical-alignment: center; }
                    Text { text: need != "" ? root.need-label : wifi ? @tr("Ready · Wi-Fi") : @tr("Ready"); font-size: 12px; font-weight: 600; color: root.tone; vertical-alignment: center; }
                }
            }
        }
        Text {
            text: listening ? @tr("Waiting for the iPhone / iPad")
                : device == "" ? @tr("Plug in an iPhone or iPad") : need != "" ? root.need-title : @tr("{} ready", device);
            font-size: 20px;
            font-weight: 700;
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: message != "" ? message
                : listening ? @tr("On the iPhone/iPad: open Control Center → Screen Mirroring → pick 3zT Mirroring. The PC and the device must be on the same network.")
                : device != "" && need != "" ? root.need-hint
                : device == "" && air && mode == "usbdirect" ? @tr("On the iPhone/iPad: Control Center → Screen Mirroring → 3zT Mirroring.")
                : device == "" && air ? @tr("Wi-Fi: the PC and the device on the same network. The first time, press Set up Wi-Fi in Settings with the cable in.")
                : device == "" ? @tr("Use a USB cable, unlock it and tap Trust.")
                : @tr("Unlock it, then press Start mirroring.");
            font-size: 12.5px;
            color: message != "" ? #ff8a80 : Theme.text-2;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        // Devices: connected ones and the ones trusted before.
        if devices.length > 0 && !listening: HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(root.width - 48px, 360px);
                spacing: 6px;
                for d in devices: Rectangle {
                    height: 44px;
                    border-radius: 12px;
                    background: d.selected ? (Theme.dark ? #ffffff14 : #ffffffd0) : devTa.has-hover ? (Theme.dark ? #ffffff0c : #ffffffa0) : (Theme.dark ? #ffffff06 : #ffffff70);
                    border-width: 1px;
                    border-color: d.selected ? Theme.accent.with-alpha(0.7) : Theme.line;
                    animate background, border-color { duration: 160ms; }
                    devTa := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick(d.id); }
                    }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: d.state == "ready" ? Theme.ok : d.state == "need" ? Theme.warn : Theme.text-3.with-alpha(0.6);
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: 1px;
                            Text { text: d.title; font-size: 12.5px; font-weight: 600; color: d.state == "offline" ? Theme.text-2 : Theme.text; overflow: elide; }
                            Text { text: d.sub; font-size: 11px; color: Theme.text-3; overflow: elide; }
                        }
                        if d.selected: VerticalLayout {
                            alignment: center;
                            Text { text: "\u{E73E}"; font-family: Theme.icons; font-size: 12px; color: Theme.accent; }
                        }
                        if d.state == "offline": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 13px;
                                background: forgetTa.has-hover ? (Theme.dark ? #ffffff1a : #0000001a) : transparent;
                                Text { text: "\u{E711}"; font-family: Theme.icons; font-size: 10px; color: Theme.text-3; horizontal-alignment: center; vertical-alignment: center; }
                                forgetTa := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.forget(d.id); }
                                }
                            }
                        }
                    }
                }
            }
        }
        // Mode and Cable / Wi-Fi, the same choices as Settings > Connection & driver.
        if device == "" || need == "": HorizontalLayout {
            alignment: center;
            spacing: 8px;
            padding-top: 4px;
            GlassButton {
                icon: "\u{E8AB}";
                label: (mode == "usbdirect" ? @tr("Studio mode") : @tr("Apple Driver")) + " · " + @tr("Change");
                tip: @tr("Choose Apple Driver or Studio mode");
                clicked => { root.change-mode(); }
            }
            Seg {
                width: 190px;
                height: 32px;
                options: ["wired", "wireless"];
                labels: [@tr("Cable (USB)"), "Wi-Fi"];
                value: root.link;
                changed(v) => { root.set-link(v); }
            }
        }
        if listening: HorizontalLayout {
            alignment: center;
            GlassButton { icon: "\u{E71A}"; label: @tr("Stop waiting"); clicked => { root.stop(); } }
        }
        if device == "" && !listening: HorizontalLayout {
            alignment: center;
            GlassButton { primary: true; icon: "\u{E768}"; label: @tr("Start"); clicked => { root.start(); } }
        }
        if device != "" && !listening: HorizontalLayout {
            alignment: center;
            if need == "" || need == "trust": GlassButton { primary: true; icon: "\u{E768}"; label: need == "" ? @tr("Start mirroring") : @tr("Try again"); clicked => { root.start(); } }
            if need != "" && need != "trust": GlassButton {
                primary: true;
                icon: "\u{E90F}";
                label: need == "restore" ? @tr("Restore Apple driver")
                    : need == "bind" ? @tr("Install driver")
                    : need == "removefilter" ? @tr("Remove filter")
                    : need == "mode" ? @tr("Choose mode")
                    : @tr("Open settings");
                clicked => { root.fix(); }
            }
        }
    }

    // Connect card (1-2-3-4) while connecting, with the error if it fails.
    if card: Rectangle {
        width: min(parent.width - 32px, 440px);
        height: cardL.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 18px;
        background: Theme.dark ? #161618f2 : #fbfbfdf2;
        border-width: 1px;
        border-color: Theme.line;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000040;
        cardL := VerticalLayout {
            padding: 20px;
            spacing: 6px;
            HorizontalLayout {
                Text {
                    text: flow-failed ? @tr("Couldn't connect")
                        : flow-step >= 4 ? @tr("Connected")
                        : device != "" ? @tr("Connecting to {}", device)
                        : @tr("Connecting");
                    font-size: 17px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text { text: round(pct * 100) + "%"; font-size: 11.5px; color: Theme.text-3; vertical-alignment: center; font-family: "Cascadia Mono"; }
            }
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.dark ? #ffffff1a : #0000001a;
                Rectangle {
                    x: 0px;
                    width: parent.width * pct;
                    border-radius: 2px;
                    background: flow-failed ? #ff6961 : Theme.text;
                }
            }
            Rectangle { height: 6px; }
            for t[i] in texts: FlowStep {
                title: t[0];
                sub: t[1];
                state: root.st(i);
                last: i == 3;
            }
            if flow-failed: VerticalLayout {
                spacing: 12px;
                padding-top: 6px;
                Text { text: message; font-size: 12.5px; color: #ff8a80; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GlassButton { label: @tr("Close"); clicked => { root.dismiss(); } }
                    GlassButton { primary: true; icon: "\u{E72C}"; label: @tr("Try again"); clicked => { root.start(); } }
                }
            }
        }
    }
}

// One connection mode in the chooser: a selectable glass card.
component ModeCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> tag;
    in property <string> badge;
    in property <string> desc;
    in property <[{ ok: bool, text: string }]> points;
    in property <bool> selected;
    in property <color> tint;
    callback pick();
    border-radius: 16px;
    background: selected ? tint.with-alpha(Theme.dark ? 0.14 : 0.10) : ta.has-hover ? Theme.hover.with-alpha(Theme.dark ? 0.10 : 0.5) : (Theme.dark ? #ffffff08 : #ffffff73);
    border-width: selected ? 1.5px : 1px;
    border-color: selected ? tint : Theme.line;
    animate background, border-color { duration: 220ms; easing: ease-out; }
    transform-scale-x: ta.pressed ? 98.5% : 100%;
    transform-scale-y: ta.pressed ? 98.5% : 100%;
    animate transform-scale-x, transform-scale-y { duration: ta.pressed ? 120ms : 320ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.pick(); } }
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 10px;
                background: @linear-gradient(135deg, root.tint 0%, root.tint.darker(0.35) 100%);
                Icon { text: root.icon; color: white; font-size: 15px; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: root.title; font-size: 14px; font-weight: 700; color: Theme.text; }
                Text { text: root.tag; font-size: 11px; color: Theme.text-2; }
            }
            if root.badge != "": VerticalLayout {
                alignment: start;
                Rectangle {
                    height: 20px;
                    width: badgeT.preferred-width + 14px;
                    border-radius: 10px;
                    background: root.tint.with-alpha(0.18);
                    badgeT := Text { text: root.badge; font-size: 10.5px; font-weight: 700; color: root.tint; }
                }
            }
            // Radio dot.
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    border-width: root.selected ? 0px : 1.5px;
                    border-color: Theme.text-3;
                    background: root.selected ? root.tint : transparent;
                    animate background { duration: 200ms; }
                    Rectangle {
                        width: root.selected ? 8px : 0px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: white;
                        animate width { duration: 300ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    }
                }
            }
        }
        Text { text: root.desc; font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
        for p in root.points: HorizontalLayout {
            spacing: 7px;
            Icon {
                text: p.ok ? "\u{E73E}" : "\u{E711}";
                font-size: 10px;
                width: 14px;
                vertical-alignment: top;
                color: p.ok ? Theme.ok : Theme.text-3;
            }
            Text { text: p.text; font-size: 11.5px; color: p.ok ? Theme.text : Theme.text-2; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }
}

// Small modal: driver confirmations, progress and results.
component NoticeSheet inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> ok;
    in property <string> cancel;
    callback answer(bool);
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: 300ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    background: #000000.with-alpha(0.5 * t);
    TouchArea { } // swallow clicks behind the sheet
    Glass {
        strong: true;
        background: Theme.dark ? #1c1c1ef2 : #f6f6f9f2;
        border-radius: 20px;
        width: min(parent.width - 24px, 440px);
        height: min(parent.height - 24px, ncol.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 20px * (1 - root.t);
        opacity: root.t;
        ncol := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: root.title; font-size: 16px; font-weight: 800; color: Theme.text; wrap: word-wrap; }
            Text { text: root.body; font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
            if root.ok != "" || root.cancel != "": HorizontalLayout {
                alignment: end;
                spacing: 8px;
                if root.cancel != "": GlassButton { label: root.cancel; clicked => { root.answer(false); } }
                if root.ok != "": GlassButton { primary: true; label: root.ok; clicked => { root.answer(true); } }
            }
        }
    }
}

// First-run (or "change mode") sheet: nothing connects and no driver
// changes until a mode is chosen here.
component ModeChooser inherits Rectangle {
    in property <bool> cancelable;
    in property <string> active;     // mode in use now ("" = none yet)
    in property <string> link: "wired";
    in property <bool> remember: true;
    in-out property <Prefs> prefs;
    callback prefs-changed(Prefs);
    callback choose(string, string, bool);
    callback cancel();
    callback back();
    property <string> pick: active;
    property <string> link-pick: link;
    property <bool> keep: remember;
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: 380ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    background: #000000.with-alpha(0.5 * t);
    TouchArea { } // swallow clicks behind the sheet
    sheet := Glass {
        strong: true;
        // A modal sheet stays readable at any glass thickness.
        background: Theme.dark ? #1c1c1ef2 : #f6f6f9f2;
        border-radius: 22px;
        width: min(parent.width - 24px, 560px);
        height: min(parent.height - 24px, col.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 24px * (1 - root.t);
        opacity: root.t;
        transform-scale-x: 0.96 + 0.04 * root.t;
        transform-scale-y: 0.96 + 0.04 * root.t;
        ScrollView {
            col := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 12px;
                    Image { source: @image-url("../../../../assets/logo-256.png"); width: 40px; height: 40px; }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: @tr("How should 3zT Mirroring connect?"); font-size: 16px; font-weight: 800; color: Theme.text; wrap: word-wrap; }
                        Text { text: @tr("Nothing connects and no driver changes until you continue."); font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                    }
                    if root.cancelable: VerticalLayout { alignment: start; GlassButton { icon: "\u{E711}"; tip: @tr("Cancel"); clicked => { root.cancel(); } } }
                }
                ModeCard {
                    icon: "\u{E83D}";
                    tint: #22c55e;
                    title: @tr("Apple Driver");
                    tag: @tr("Standard · full control");
                    badge: @tr("Recommended");
                    desc: @tr("Uses Apple's own driver. Most compatible, stable and easy.");
                    points: [
                        { ok: true, text: @tr("Up to 60 fps, HEVC (device-limited bitrate, about 4–6 Mbps)") },
                        { ok: true, text: @tr("Mouse touch, keyboard, gestures and buttons") },
                        { ok: true, text: @tr("Apple's own driver, nothing to install") },
                        { ok: true, text: @tr("Cable or Wi-Fi (after a one-time setup with the cable)") },
                        { ok: true, text: @tr("iOS 17–26: Hybrid Control (experimental)") },
                        { ok: false, text: @tr("iOS 16 or older: use Studio mode") },
                    ];
                    selected: root.pick == "apple";
                    pick => { root.pick = "apple"; }
                }
                ModeCard {
                    icon: "\u{E945}";
                    tint: #8e8e93;
                    title: @tr("Studio mode");
                    tag: @tr("For live streaming");
                    desc: @tr("Best quality for streaming: high bitrate (measured 12–30 Mbps), up to 60 fps, very low latency. Needs the libusb0 driver.");
                    points: [
                        { ok: true, text: @tr("Up to 60 fps, full native resolution over the cable, high-bitrate H.264") },
                        { ok: true, text: @tr("Cable (USB) or Wi-Fi (AirPlay, no driver)") },
                        { ok: false, text: @tr("Picture and sound only: no touch, keyboard or gestures") },
                        { ok: false, text: @tr("Apple apps can't see the device until you switch back") },
                    ];
                    selected: root.pick == "usbdirect";
                    pick => { root.pick = "usbdirect"; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: @tr("Connection"); font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Seg {
                        width: 240px;
                        options: ["wired", "wireless"];
                        labels: [@tr("Cable"), "Wi-Fi"];
                        value: root.link-pick;
                        changed(v) => { root.link-pick = v; }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: @tr("Remember my choice"); font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Toggle { checked: root.keep; toggled(v) => { root.keep = v; } }
                }
                Text {
                    text: @tr("You can change it any time in Settings › Connection & driver. Changing it may need an app restart and reconnecting the cable.");
                    font-size: 11px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    GlassButton { icon: "\u{E72B}"; label: @tr("Back"); tip: @tr("Change device type"); clicked => { root.back(); } }
                    Rectangle { horizontal-stretch: 1; }
                    if root.cancelable: GlassButton { label: @tr("Cancel"); clicked => { root.cancel(); } }
                    GlassButton {
                        primary: true;
                        enabled: root.pick != "";
                        icon: "\u{E72A}";
                        label: @tr("Continue");
                        clicked => { root.choose(root.pick, root.link-pick, root.keep); }
                    }
                }
            }
        }
    }
}

// One platform on the first screen: a large selectable glass card.
// Click or Space selects it; Enter or a double-click also continues.
component PlatformCard inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> desc;
    in property <[string]> points;
    in property <string> badge;
    in property <bool> selected;
    in property <color> tint;
    callback pick();
    callback activate();
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.desc;
    accessible-action-default => { root.pick(); }
    // Wrapped text can be taller than the layout's estimate: keep room.
    min-height: col.preferred-height + 20px;
    border-radius: 18px;
    background: selected ? tint.with-alpha(Theme.dark ? 0.15 : 0.11) : ta.has-hover ? Theme.hover.with-alpha(Theme.dark ? 0.10 : 0.5) : (Theme.dark ? #ffffff08 : #ffffff73);
    border-width: selected || fs.has-focus ? 1.5px : 1px;
    border-color: selected ? tint : fs.has-focus ? Theme.accent : Theme.line;
    animate background, border-color { duration: 220ms; easing: ease-out; }
    transform-scale-x: ta.pressed ? 98.5% : 100%;
    transform-scale-y: ta.pressed ? 98.5% : 100%;
    animate transform-scale-x, transform-scale-y { duration: ta.pressed ? 120ms : 320ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
    fs := FocusScope {
        key-pressed(ev) => {
            if ev.text == " " { root.pick(); return accept; }
            if ev.text == Key.Return { root.pick(); root.activate(); return accept; }
            reject
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { fs.focus(); root.pick(); }
        double-clicked => { root.pick(); root.activate(); }
    }
    col := VerticalLayout {
        padding: 18px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                background: @linear-gradient(135deg, root.tint 0%, root.tint.darker(0.35) 100%);
                Icon { text: root.icon; color: white; font-size: 22px; }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                spacing: 4px;
                Text { text: root.title; font-size: 16px; font-weight: 800; color: Theme.text; wrap: word-wrap; }
                if root.badge != "": HorizontalLayout {
                    alignment: start;
                    Rectangle {
                        height: 20px;
                        width: badgeT.preferred-width + 14px;
                        border-radius: 10px;
                        background: root.tint.with-alpha(0.18);
                        badgeT := Text { text: root.badge; font-size: 10.5px; font-weight: 700; color: root.tint; }
                    }
                }
            }
            // Radio dot.
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    border-width: root.selected ? 0px : 1.5px;
                    border-color: Theme.text-3;
                    background: root.selected ? root.tint : transparent;
                    animate background { duration: 200ms; }
                    Rectangle {
                        width: root.selected ? 8px : 0px;
                        height: self.width;
                        border-radius: self.width / 2;
                        background: white;
                        animate width { duration: 300ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    }
                }
            }
        }
        Text { text: root.desc; font-size: 12px; color: Theme.text-2; wrap: word-wrap; }
        for p in root.points: HorizontalLayout {
            spacing: 7px;
            Icon { text: "\u{E73E}"; font-size: 10px; width: 14px; vertical-alignment: top; color: Theme.ok; }
            Text { text: p; font-size: 11.5px; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
        }
    }
}

// First screen: which device family to connect. Nothing connects
// and no driver changes here; iPhone / iPad leads to the Apple mode chooser.
component PlatformSelector inherits Rectangle {
    in property <string> picked;          // "" | apple | android
    in property <bool> remember;
    in property <bool> apple-detected;
    in property <int> android-count;
    in-out property <Prefs> prefs;
    callback prefs-changed(Prefs);
    callback choose(string, bool);
    property <string> pick: picked;
    property <bool> keep: remember;
    property <string> apple-badge: root.apple-detected ? @tr("Detected") : "";
    property <string> android-badge: root.android-count > 0 ? @tr("{} detected", root.android-count) : "";
    property <string> apple-desc: @tr("Mirror and control compatible Apple devices using USB or Wi-Fi.");
    property <string> android-title: @tr("Android Smartphone / Tablet");
    property <string> android-desc: @tr("High-performance Android mirroring and control over USB or Wi-Fi.");
    property <[string]> apple-points: [
        @tr("Apple Driver or Studio mode"),
        @tr("Cable or Wi-Fi"),
    ];
    property <[string]> android-points: [
        @tr("Through ADB and scrcpy, no app on the phone"),
        @tr("Cable or Wi-Fi, any Android brand"),
    ];
    property <float> t: 0;
    init => { self.t = 1; }
    animate t { duration: 380ms; easing: cubic-bezier(0.05, 0.7, 0.1, 1); }
    background: #000000.with-alpha(0.5 * t);
    TouchArea { } // swallow clicks behind the sheet
    sheet := Glass {
        strong: true;
        background: Theme.dark ? #1c1c1ef2 : #f6f6f9f2;
        border-radius: 22px;
        width: min(parent.width - 24px, 640px);
        height: min(parent.height - 24px, col.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + 24px * (1 - root.t);
        opacity: root.t;
        transform-scale-x: 0.96 + 0.04 * root.t;
        transform-scale-y: 0.96 + 0.04 * root.t;
        property <bool> wide: self.width >= 560px;
        ScrollView {
            col := VerticalLayout {
                padding: 20px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 12px;
                    Image { source: @image-url("../../../../assets/logo-256.png"); width: 44px; height: 44px; }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            alignment: start;
                            spacing: 6px;
                            Text { text: @tr("Welcome to 3zT Mirroring"); font-size: 12px; font-weight: 600; color: Theme.accent; vertical-alignment: center; }
                            Text { text: "v" + AppInfo.version; font-size: 9.5px; font-weight: 700; letter-spacing: 1px; color: Theme.text-2; vertical-alignment: center; }
                        }
                        Text { text: @tr("Which device would you like to connect?"); font-size: 18px; font-weight: 800; color: Theme.text; wrap: word-wrap; }
                    }
                }
                if sheet.wide: HorizontalLayout {
                    spacing: 12px;
                    PlatformCard {
                        horizontal-stretch: 1;
                        icon: "\u{E8EA}";
                        tint: #5ac8fa;
                        title: @tr("iPhone / iPad");
                        desc: root.apple-desc;
                        points: root.apple-points;
                        badge: root.apple-badge;
                        selected: root.pick == "apple";
                        pick => { root.pick = "apple"; }
                        activate => { root.choose("apple", root.keep); }
                    }
                    PlatformCard {
                        horizontal-stretch: 1;
                        icon: "\u{E70A}";
                        tint: #3ddc84;
                        title: root.android-title;
                        desc: root.android-desc;
                        points: root.android-points;
                        badge: root.android-badge;
                        selected: root.pick == "android";
                        pick => { root.pick = "android"; }
                        activate => { root.choose("android", root.keep); }
                    }
                }
                if !sheet.wide: VerticalLayout {
                    spacing: 10px;
                    PlatformCard {
                        icon: "\u{E8EA}";
                        tint: #5ac8fa;
                        title: @tr("iPhone / iPad");
                        desc: root.apple-desc;
                        points: root.apple-points;
                        badge: root.apple-badge;
                        selected: root.pick == "apple";
                        pick => { root.pick = "apple"; }
                        activate => { root.choose("apple", root.keep); }
                    }
                    PlatformCard {
                        icon: "\u{E70A}";
                        tint: #3ddc84;
                        title: root.android-title;
                        desc: root.android-desc;
                        points: root.android-points;
                        badge: root.android-badge;
                        selected: root.pick == "android";
                        pick => { root.pick = "android"; }
                        activate => { root.choose("android", root.keep); }
                    }
                }
                if root.apple-detected && root.android-count > 0: Text {
                    text: @tr("Apple and Android devices are both connected. Choose the one to mirror.");
                    font-size: 11.5px;
                    color: Theme.warn;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: @tr("Remember device type"); font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                    Toggle { checked: root.keep; toggled(v) => { root.keep = v; } }
                }
                Text {
                    text: @tr("You can change it any time in Settings › Device type or with the Back button.");
                    font-size: 11px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: end;
                    GlassButton {
                        primary: true;
                        enabled: root.pick != "";
                        icon: "\u{E72A}";
                        label: @tr("Continue");
                        clicked => { root.choose(root.pick, root.keep); }
                    }
                }
            }
        }
    }
}

export struct AndroidRow {
    title: string,
    sub: string,
    ok: bool,
    // Ready over USB with no Wi-Fi link yet: offer "Wi-Fi" (adb tcpip).
    wifi: bool,
    // Connected over USB and Wi-Fi at once: the user picks the link.
    both: bool,
}

// One installed app in the app picker.
export struct AppRow {
    name: string,
    sub: string,
    // Launcher tile: one or two letters on a colour from the package name
    // (scrcpy gives no icons).
    letter: string,
    tint: color,
}

// One numbered instruction step: a plain wrapped Text (nested layouts
// measured wrapped text too short and overlapped the next element).
component StepRow inherits Text {
    font-size: 11.5px;
    color: Theme.text-2;
    wrap: word-wrap;
}

// Indeterminate progress: a short bar sliding left to right. It only
// animates while it is shown.
component BusyBar inherits Rectangle {
    height: 3px;
    border-radius: 1.5px;
    background: Theme.fill;
    clip: true;
    Rectangle {
        width: parent.width * 0.3;
        height: parent.height;
        border-radius: 1.5px;
        background: Theme.accent;
        x: (mod(animation-tick() / 1ms, 1400) / 1400) * parent.width * 1.3 - self.width;
    }
}

// A single-line glass text field (Wi-Fi address, pairing code).
component Field inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> ti.text;
    in property <InputType> input-type: InputType.text;
    callback accepted();
    callback edited(string);
    height: 32px;
    horizontal-stretch: 1;
    border-radius: 10px;
    background: ti.has-focus ? Theme.fill-hover : Theme.fill;
    border-width: 0.75px;
    border-color: ti.has-focus ? Theme.accent : (Theme.glass > 0.01 ? Theme.rim : Theme.line);
    animate background, border-color { duration: 180ms; easing: ease-out; }
    TouchArea { mouse-cursor: MouseCursor.text; clicked => { ti.focus(); } }
    if ti.text == "": Text {
        x: 11px;
        text: root.placeholder;
        font-size: 12px;
        color: Theme.text-3;
        vertical-alignment: center;
        height: parent.height;
    }
    ti := TextInput {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        input-type: root.input-type;
        font-size: 12px;
        color: Theme.text;
        selection-background-color: Theme.accent-soft;
        accepted => { root.accepted(); }
        edited => { root.edited(self.text); }
    }
}

// Android workspace: setup steps, the devices ADB sees, and Start per
// ready device.
// Android picture settings (scrcpy server options). Shown before Start and
// in Settings on the Android screen; a change restarts a running session.
component AndroidVideoCard inherits Card {
    in-out property <Prefs> prefs;
    // Windows can decode H.265 (HEVC Video Extensions or a GPU driver decoder).
    in property <bool> hevc-ok;
    callback changed(Prefs);
    title: @tr("Android video");
    icon: "\u{E714}";
    tint-a: #3ddc84;
    tint-b: #1f9d55;
    info: @tr("A profile fills in resolution, FPS, bitrate and codec; change one value and the profile becomes Custom. Each phone keeps its own settings (the same over USB and Wi-Fi). Encoders are read from the phone on the first mirroring; if the chosen encoder fails, 3zT Mirroring tries another hardware encoder, then H.264, at most 4 times, and keeps your choice.");
    Row { label: @tr("Profile"); }
    Seg {
        options: ["low-latency", "balanced", "high-quality", "streaming", "custom"];
        labels: [@tr("Low Latency"), @tr("Balanced"), @tr("High Quality"), @tr("Streaming"), @tr("Custom")];
        value: prefs.android-profile;
        changed(v) => { root.prefs.android-profile = v; root.changed(root.prefs); }
    }
    Row { label: @tr("Resolution"); hint: @tr("Longest side."); }
    Seg {
        options: ["1280", "1920", "2560", "0"];
        labels: ["720p", "1080p", "1440p", @tr("Native")];
        value: prefs.android-max-size;
        changed(v) => { root.prefs.android-max-size = v; root.changed(root.prefs); }
    }
    Row { label: @tr("FPS"); hint: @tr("A cap; the phone never goes above its refresh rate."); }
    Seg {
        options: ["30", "60", "90", "120", "144"];
        labels: ["30", "60", "90", "120", "144"];
        value: prefs.android-fps;
        changed(v) => { root.prefs.android-fps = v; root.changed(root.prefs); }
    }
    Row { label: @tr("Bitrate"); }
    Seg {
        options: ["4", "8", "16", "24", "40"];
        labels: ["4", "8", "16", "24", @tr("40 Mbps")];
        value: prefs.android-bitrate;
        changed(v) => { root.prefs.android-bitrate = v; root.changed(root.prefs); }
    }
    // Codecs: what both the phone and Windows support once detected; before
    // that, what Windows can decode.
    property <bool> h265-ok: AndroidEnc.codecs.length > 0 ? (AndroidEnc.codecs.length > 1 && AndroidEnc.codecs[1] == "h265") : root.hevc-ok;
    Row {
        label: @tr("Codec");
        hint: !root.hevc-ok ? @tr("H.265 needs HEVC Video Extensions on Windows.")
            : AndroidEnc.codecs.length == 1 ? @tr("This phone has no H.265 encoder.")
            : @tr("Auto = H.264, the lowest latency.");
    }
    Seg {
        options: root.h265-ok ? ["auto", "h264", "h265"] : ["auto", "h264"];
        labels: root.h265-ok ? [@tr("Auto"), "H.264", @tr("H.265 (HEVC)")] : [@tr("Auto"), "H.264"];
        value: prefs.android-codec;
        changed(v) => { root.prefs.android-codec = v; root.changed(root.prefs); }
    }
    Row {
        label: @tr("Encoder");
        hint: AndroidEnc.detected != "" ? AndroidEnc.detected : @tr("Detected on the first mirroring.");
    }
    if AndroidEnc.options.length > 1: Seg {
        options: AndroidEnc.options;
        labels: AndroidEnc.labels;
        value: prefs.android-encoder;
        changed(v) => { root.prefs.android-encoder = v; root.changed(root.prefs); }
    }
    if AndroidEnc.using != "": Row {
        label: @tr("In use");
        hint: AndroidEnc.using;
    }
}

component AndroidHome inherits Rectangle {
    in property <string> status;
    in property <[AndroidRow]> devices;
    // "idle", "connecting", "error" (the workspace hides while streaming).
    in property <string> phase: "idle";
    in property <string> message;
    in-out property <Prefs> prefs;
    in property <bool> hevc-ok;
    callback prefs-changed(Prefs);
    callback back();
    callback start-device(int);
    callback start-device-via(int, string);
    // Android over Wi-Fi.
    in property <bool> wifi-busy;
    // Current Wi-Fi step while busy ("Reading the phone's Wi-Fi address…").
    in property <string> wifi-status;
    property <bool> code-open: false;
    callback wifi-device(int);
    callback wifi-connect(string);
    callback wifi-pair(string, string);
    // QR pairing: the image, a status line, and whether it runs.
    in property <image> qr-image;
    in property <bool> qr-on;
    in property <string> qr-status;
    callback wifi-qr();
    callback wifi-qr-cancel();
    property <bool> wifi-open: false;
    Glass {
        width: min(parent.width - 32px, 460px);
        height: min(parent.height - 32px, acol.preferred-height + 2px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 20px;
        ScrollView {
            acol := VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 11px;
                        background: @linear-gradient(135deg, #3ddc84 0%, #3ddc84.darker(0.35) 100%);
                        Icon { text: "\u{E70A}"; color: white; font-size: 17px; }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: @tr("Android Smartphone / Tablet"); font-size: 15px; font-weight: 800; color: Theme.text; }
                        Text { text: root.status; font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                    }
                }
                for d[i] in root.devices: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 5px;
                        Rectangle { width: 8px; height: 8px; border-radius: 4px; background: d.ok ? Theme.ok : Theme.warn; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text { text: d.title; font-size: 12.5px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                        Text { text: d.sub; font-size: 11px; color: Theme.text-2; wrap: word-wrap; }
                    }
                    if d.wifi && root.phase != "connecting": VerticalLayout {
                        alignment: center;
                        GlassButton {
                            icon: "\u{E701}";
                            label: "Wi-Fi";
                            enabled: !root.wifi-busy;
                            tip: @tr("Switch to Wi-Fi: once connected, you can unplug the cable");
                            clicked => { root.wifi-device(i); }
                        }
                    }
                    if d.ok && !d.both && root.phase != "connecting": VerticalLayout {
                        alignment: center;
                        GlassButton {
                            primary: true;
                            icon: "\u{E768}";
                            label: @tr("Start");
                            tip: @tr("Start mirroring this device");
                            clicked => { root.start-device(i); }
                        }
                    }
                    // On USB and Wi-Fi at once: one Start per link.
                    if d.both && root.phase != "connecting": HorizontalLayout {
                        alignment: end;
                        spacing: 6px;
                        GlassButton {
                            primary: true;
                            icon: "\u{E768}";
                            label: "USB";
                            tip: @tr("Start over the USB cable (most stable, lowest delay)");
                            clicked => { root.start-device-via(i, "usb"); }
                        }
                        GlassButton {
                            primary: true;
                            icon: "\u{E701}";
                            label: "Wi-Fi";
                            tip: @tr("Start over Wi-Fi (you can unplug the cable)");
                            clicked => { root.start-device-via(i, "wifi"); }
                        }
                    }
                }
                if root.phase == "connecting": Text {
                    text: @tr("Connecting… the phone starts the scrcpy server.");
                    font-size: 11.5px;
                    color: Theme.accent;
                    wrap: word-wrap;
                }
                if root.message != "": Text {
                    text: root.message;
                    font-size: 11.5px;
                    color: Theme.warn;
                    wrap: word-wrap;
                }
                // Wi-Fi work in progress (switch to Wi-Fi, pair, connect):
                // a moving bar and the current step, so it never looks stuck.
                if root.wifi-busy: VerticalLayout {
                    spacing: 6px;
                    BusyBar { }
                    Text {
                        text: root.wifi-status != "" ? root.wifi-status : @tr("Working…");
                        font-size: 11.5px;
                        color: Theme.accent;
                        wrap: word-wrap;
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    GlassButton {
                        icon: "\u{E701}";
                        label: @tr("Connect over Wi-Fi");
                        active: root.wifi-open;
                        tip: @tr("Scan a QR code, a pairing code or an IP:port address");
                        clicked => { root.wifi-open = !root.wifi-open; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                if root.wifi-open || root.qr-on: Card {
                    VerticalLayout {
                        spacing: 10px;
                        Text {
                            text: @tr("Already on the cable? Press the Wi-Fi button next to the phone's name, done. Without a cable (Android 11+):");
                            font-size: 11.5px;
                            color: Theme.text-2;
                            wrap: word-wrap;
                        }
                        if !root.qr-on: VerticalLayout {
                            spacing: 6px;
                            Text { text: @tr("Option 1 · Scan a QR code (easiest)"); font-size: 12.5px; font-weight: 650; color: Theme.text; }
                            StepRow { text: "1.  " + @tr("The phone and the PC are on the same Wi-Fi."); }
                            StepRow { text: "2.  " + @tr("On the phone: Settings › Developer options › Wireless debugging › turn it on."); }
                            StepRow { text: "3.  " + @tr("Press the button below, then on the phone tap \"Pair device with QR code\" and scan."); }
                            HorizontalLayout {
                                alignment: start;
                                GlassButton {
                                    primary: true;
                                    icon: "\u{ED14}";
                                    label: @tr("Show QR code");
                                    enabled: !root.wifi-busy;
                                    tip: @tr("Show a QR code to scan on the phone");
                                    clicked => { root.wifi-qr(); }
                                }
                            }
                        }
                        if root.qr-on: VerticalLayout {
                            spacing: 8px;
                            alignment: start;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 196px;
                                    height: 196px;
                                    border-radius: 12px;
                                    background: white;
                                    Image {
                                        source: root.qr-image;
                                        width: 180px;
                                        height: 180px;
                                        image-rendering: pixelated;
                                    }
                                }
                            }
                            Text {
                                text: @tr("On the phone: Wireless debugging › \"Pair device with QR code\", then scan this code.");
                                font-size: 11.5px;
                                color: Theme.text-2;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                            BusyBar { }
                            Text {
                                text: root.qr-status;
                                font-size: 11.5px;
                                color: Theme.accent;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                alignment: center;
                                GlassButton {
                                    icon: "\u{E711}";
                                    label: @tr("Cancel");
                                    clicked => { root.wifi-qr-cancel(); }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: @tr("Option 2 · Pairing code or IP address"); font-size: 12.5px; font-weight: 650; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                            GlassButton {
                                label: root.code-open ? @tr("Hide") : @tr("Show");
                                clicked => { root.code-open = !root.code-open; }
                            }
                        }
                        if root.code-open: VerticalLayout {
                            spacing: 6px;
                            StepRow { text: "1.  " + @tr("In Wireless debugging, tap \"Pair device with pairing code\"."); }
                            StepRow { text: "2.  " + @tr("Enter the IP:port and the 6-digit code shown in that window, press Pair."); }
                            StepRow { text: "3.  " + @tr("Enter the IP:port from the main Wireless debugging screen (a different port), press Connect. Paired before? Go straight to step 3."); }
                            HorizontalLayout {
                                spacing: 8px;
                                addr := Field {
                                    placeholder: @tr("IP:port, e.g. 192.168.1.20:37099");
                                    accepted => { if !root.wifi-busy { root.wifi-connect(self.text); } }
                                }
                                code := Field {
                                    horizontal-stretch: 0;
                                    width: 96px;
                                    placeholder: @tr("6-digit code");
                                    input-type: InputType.number;
                                    accepted => { if !root.wifi-busy { root.wifi-pair(addr.text, self.text); } }
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                GlassButton {
                                    icon: "\u{E8D7}";
                                    label: @tr("Pair");
                                    enabled: !root.wifi-busy && code.text != "";
                                    tip: @tr("Step 2: pair once with the code from the phone");
                                    clicked => { root.wifi-pair(addr.text, code.text); }
                                }
                                GlassButton {
                                    primary: true;
                                    icon: "\u{E71B}";
                                    label: @tr("Connect");
                                    enabled: !root.wifi-busy && addr.text != "";
                                    tip: @tr("Step 3: connect to this address (adb connect)");
                                    clicked => { root.wifi-connect(addr.text); }
                                }
                            }
                        }
                    }
                }
                AndroidVideoCard {
                    prefs: root.prefs;
                    hevc-ok: root.hevc-ok;
                    changed(p) => { root.prefs-changed(p); }
                }
                FlowStep {
                    title: @tr("Turn on USB debugging");
                    sub: @tr("Settings › About phone › tap Build number 7×, then Developer options › USB debugging.");
                    state: "todo";
                }
                FlowStep {
                    title: @tr("Plug in the USB cable");
                    sub: @tr("Use a data cable, not a charge-only cable.");
                    state: "todo";
                }
                FlowStep {
                    title: @tr("Allow it on the phone");
                    sub: @tr("Tap Allow on the Allow USB debugging prompt.");
                    state: "todo";
                    last: true;
                }
                Text {
                    text: @tr("Beta: picture, sound (Android 11+) and control from the PC. No driver is installed or changed.");
                    font-size: 11px;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    GlassButton { icon: "\u{E72B}"; label: @tr("Change device type"); clicked => { root.back(); } }
                }
            }
        }
    }
}

// One line of the shortcut list: key cap(s) and what they do.
component KeyRow inherits HorizontalLayout {
    in property <string> keys;
    in property <string> text;
    spacing: 10px;
    Rectangle {
        width: 132px;
        HorizontalLayout {
            alignment: start;
            Rectangle {
                height: 22px;
                width: kt.preferred-width + 14px;
                border-radius: 6px;
                background: Theme.dark ? #ffffff14 : #0000000d;
                border-width: 1px;
                border-color: Theme.rim;
                kt := Text { text: root.keys; font-size: 11px; font-weight: 600; color: Theme.text; horizontal-alignment: center; vertical-alignment: center; }
            }
        }
    }
    Text { text: root.text; font-size: 11.5px; color: Theme.text-2; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
}

component SettingsPanel inherits Glass {
    in-out property <Prefs> prefs;
    in property <string> driver-text;
    in property <string> connection;
    // Cable or Wi-Fi, for both Apple Driver and Studio mode.
    in property <string> link: "wired";
    in property <string> mode;
    in property <string> screen: "apple";
    // Driver changes that fit the device (each asks for confirmation).
    in property <bool> drv-restore;
    in property <bool> drv-bind;
    in property <bool> drv-filter;
    // Updates: status line, the offered version ("" = none),
    // download progress 0..1 (-1 = not downloading).
    in property <string> upd-status;
    in property <string> upd-version;
    in property <string> upd-notes;
    in property <bool> upd-switch;
    in property <bool> upd-busy;
    in property <float> upd-progress: -1;
    in property <string> upd-channel-own: "beta";
    callback update-action(string);
    callback set-link(string);
    // Studio mode (USB Direct / AirPlay): picture and sound only. Touch,
    // keyboard, buttons, device shortcuts and auto unlock need Apple Driver mode.
    property <bool> studio: root.screen != "android" && root.mode == "usbdirect";
    // Auto unlock (Apple Driver mode): a passcode is saved on this PC.
    in property <bool> passcode-set;
    callback save-passcode(string);
    in property <string> stats-full;
    in property <bool> hevc-ok;
    callback changed(Prefs);
    callback close();
    callback driver-action(string);
    border-radius: 20px;
    VerticalLayout {
        HorizontalLayout {
            padding: 12px;
            padding-bottom: 4px;
            spacing: 10px;
            Image { source: @image-url("../../../../assets/logo-256.png"); width: 30px; height: 30px; }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: "3zT Mirroring"; font-size: 15px; font-weight: 800; color: Theme.text; }
                Text { text: @tr("Settings & controls"); font-size: 11px; color: Theme.accent; font-weight: 600; }
            }
            GlassButton { icon: "\u{E711}"; clicked => { root.close(); } }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 12px;
                padding-top: 6px;
                spacing: 10px;

                Card {
                    title: @tr("Appearance");
                    icon: "\u{E790}";
                    tint-a: #a1a1aa;
                    tint-b: #52525b;
                    info: @tr("Liquid Glass shows the real desktop behind the window. Thickness 0% = fully clear with no blur, higher = more frosted (Windows' own blur). Turn it off for a solid window with no extra GPU work.");
                    Seg {
                        options: ["light", "dark", "system"];
                        labels: [@tr("Light"), @tr("Dark"), @tr("System")];
                        value: prefs.theme;
                        changed(v) => { root.prefs.theme = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: @tr("Language");
                        Seg {
                            width: 230px;
                            options: ["", "en", "ar"];
                            labels: [@tr("System"), "English", "العربية"];
                            value: prefs.language;
                            changed(v) => { root.prefs.language = v; root.changed(root.prefs); }
                        }
                    }
                    Row {
                        label: @tr("Liquid Glass");
                        Toggle { checked: prefs.glass-on; toggled(v) => { root.prefs.glass-on = v; root.changed(root.prefs); } }
                    }
                    if prefs.glass-on: Row {
                        label: @tr("Glass thickness");
                        Text { text: round(prefs.glass) + "%" + (prefs.glass < 1 ? @tr(" · clear") : ""); font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
                    }
                    if prefs.glass-on: GlassSlider {
                        step: 5;
                        value: prefs.glass;
                        changed(v) => { root.prefs.glass = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: @tr("Animated background");
                        Toggle { checked: prefs.dots; toggled(v) => { root.prefs.dots = v; root.changed(root.prefs); } }
                    }
                }

                Card {
                    title: @tr("Display & aspect");
                    icon: "\u{E7F4}";
                    tint-a: #a78bfa;
                    tint-b: #7c3aed;
                    info: @tr("Auto-Fit shows the whole device screen. Edge-to-Edge fills the area and crops the sides. The window follows the device's size and orientation (portrait / landscape).");
                    Seg {
                        options: ["contain", "cover", "fill"];
                        labels: [@tr("Auto-Fit"), @tr("Edge-to-Edge"), @tr("Stretch")];
                        value: prefs.fit;
                        changed(v) => { root.prefs.fit = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: @tr("Window follows the screen");
                        hint: @tr("Portrait / landscape automatically");
                        Toggle { checked: prefs.fit-window; toggled(v) => { root.prefs.fit-window = v; root.changed(root.prefs); } }
                    }
                    Text { text: @tr("Rotation"); font-size: 12.5px; color: Theme.text; }
                    Seg {
                        options: ["auto", "0", "90", "180", "270"];
                        labels: [@tr("Auto"), "0°", "90°", "180°", "270°"];
                        value: prefs.rotation;
                        changed(v) => { root.prefs.rotation = v; root.changed(root.prefs); }
                    }
                }


                Card {
                    title: @tr("Record / stream in OBS");
                    icon: "\u{E714}";
                    tint-a: #f87171;
                    tint-b: #dc2626;
                    info: @tr("Game Capture takes the picture straight from the GPU: sharp, no window frame, and it keeps working when 3zT Mirroring is behind other windows. Window Capture also works, but it picks up the window frame too.");
                    Text {
                        text: @tr("In OBS, add a Game Capture source → Mode: capture specific window → pick [3zTMirroring.exe]: 3zT Mirroring. Then select it and press Ctrl+F (Fit to screen): portrait / landscape stays centred automatically.");
                        font-size: 11.5px;
                        color: Theme.text-2;
                        wrap: word-wrap;
                    }
                }

                Card {
                    title: @tr("Device audio → PC");
                    icon: "\u{E767}";
                    tint-a: #fb923c;
                    tint-b: #ea580c;
                    info: @tr("Sound plays through WASAPI on this PC. Lip sync holds the picture a little so it matches the sound. Low buffer is tighter, high rides out hiccups.");
                    Seg {
                        options: ["pc", "device"];
                        labels: [@tr("On this PC"), @tr("Device only")];
                        value: prefs.audio-out;
                        changed(v) => { root.prefs.audio-out = v; root.changed(root.prefs); }
                    }
                    Row {
                        label: @tr("PC volume");
                        Text { text: round(prefs.volume) + "%"; font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
                    }
                    GlassSlider { value: prefs.volume; changed(v) => { root.prefs.volume = v; root.changed(root.prefs); } }
                    Row {
                        label: @tr("Lip sync");
                        Toggle { checked: prefs.lip-sync; toggled(v) => { root.prefs.lip-sync = v; root.changed(root.prefs); } }
                    }
                    Seg {
                        options: ["low", "normal", "high"];
                        labels: [@tr("Low"), @tr("Normal"), @tr("High")];
                        value: prefs.audio-buffer;
                        changed(v) => { root.prefs.audio-buffer = v; root.changed(root.prefs); }
                    }
                }

                if !root.studio: Card {
                    title: @tr("Control");
                    icon: "\u{E765}";
                    tint-a: #38bdf8;
                    tint-b: #0284c7;
                    info: root.screen == "android"
                        ? @tr("Click = tap, drag = swipe, scroll = scroll on the phone. Right click = Back, middle click = Home. Click the picture first so the PC keyboard types on the phone.")
                        : @tr("Click and drag = touch. Mouse Back button = swipe back. The PC keyboard works as a hardware keyboard in Apple Driver mode; click the picture first.");
                    Row { label: @tr("Touch with the mouse"); Toggle { checked: prefs.touch; toggled(v) => { root.prefs.touch = v; root.changed(root.prefs); } } }
                    Row { label: @tr("PC keyboard to the device"); Toggle { checked: prefs.keyboard; toggled(v) => { root.prefs.keyboard = v; root.changed(root.prefs); } } }
                    if root.screen != "android": Row { label: @tr("Gestures (scroll, mouse Back button)"); Toggle { checked: prefs.gestures; toggled(v) => { root.prefs.gestures = v; root.changed(root.prefs); } } }
                }

                Card {
                    title: @tr("Keyboard shortcuts");
                    icon: "\u{E92E}";
                    tint-a: #a78bfa;
                    tint-b: #7c3aed;
                    info: @tr("While the PC keyboard types on the device, single keys (Space, M) go to the device; Alt and Ctrl shortcuts stay with 3zT Mirroring.");
                    KeyRow { keys: "Alt + M"; text: @tr("Sound on the PC on / off"); }
                    KeyRow { keys: "F2"; text: @tr("Show / hide the controls around the picture"); }
                    KeyRow { keys: "F11 · Esc"; text: @tr("Full screen / leave"); }
                    KeyRow { keys: "Ctrl + ,"; text: @tr("Open / close Settings"); }
                    KeyRow { keys: "Alt + H"; text: @tr("Rotate the view (Auto, 90°, 180°, 270°, 0°)"); }
                    if !root.studio: KeyRow { keys: @tr("Alt + ←"); text: @tr("Back"); }
                    KeyRow { keys: "Alt + C"; text: @tr("Copy the text on the device screen to the PC (OCR)"); }
                    KeyRow { keys: "Alt + R"; text: @tr("Clear the copied-text history"); }
                    if !root.studio: KeyRow { keys: @tr("Alt + L"); text: root.screen == "android" ? @tr("Power button (lock / wake the screen)") : @tr("Lock the device"); }
                    if root.screen == "android": KeyRow { keys: @tr("Ctrl + V"); text: @tr("Paste the PC clipboard on the phone"); }
                    if root.screen == "android": KeyRow { keys: @tr("Ctrl + C / X / A / Z"); text: @tr("Copy, cut, select all, undo on the phone"); }
                    if !root.studio: KeyRow { keys: @tr("Alt + N"); text: root.screen == "android" ? @tr("Notifications") : @tr("Notification Center (open / close)"); }
                    if !root.studio: KeyRow { keys: @tr("Alt + Q"); text: root.screen == "android" ? @tr("Quick Settings") : @tr("Control Center (open / close)"); }
                    if root.screen == "android": KeyRow { keys: @tr("Alt + S"); text: @tr("Recent Apps"); }
                    if root.screen == "android": KeyRow { keys: @tr("Alt + ↑ / ↓"); text: @tr("Phone volume up / down"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: @tr("Alt + U"); text: @tr("Wake & unlock (saved passcode)"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: @tr("Alt + D"); text: @tr("Stealth dim: device screen to 0% / restore"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: @tr("Alt + V"); text: @tr("Type the PC clipboard text on the device"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: @tr("Ctrl + K"); text: @tr("Show / hide the on-screen keyboard"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: @tr("Ctrl + C / X / V / A / Z"); text: @tr("Copy, cut, paste, select all, undo in iOS"); }
                    if root.screen != "android" && !root.studio: KeyRow { keys: @tr("Alt + G"); text: @tr("Switch the device keyboard between English and Arabic (Arabic needs the \"Arabic – PC\" hardware layout on the device)"); }
                    if root.screen != "android": Text {
                        text: root.studio ? @tr("Studio mode is picture and sound only: device control and its shortcuts are in Apple Driver mode.")
                            : @tr("Apple device shortcuts work in Apple Driver mode while mirroring.");
                        font-size: 11px;
                        color: Theme.text-3;
                        wrap: word-wrap;
                    }
                }

                Card {
                    title: @tr("Device type");
                    icon: "\u{E8EA}";
                    tint-a: #5ac8fa;
                    tint-b: #0a84ff;
                    info: @tr("Choose iPhone / iPad or Android. A running session is stopped safely first. Apple and Android settings are kept separately.");
                    Text { text: root.screen == "android" ? @tr("Android Smartphone / Tablet") : @tr("iPhone / iPad"); font-size: 12.5px; font-weight: 600; color: Theme.text; }
                    Row {
                        label: @tr("Remember device type");
                        Toggle { checked: prefs.remember-platform; toggled(v) => { root.prefs.remember-platform = v; root.changed(root.prefs); } }
                    }
                    HorizontalLayout {
                        alignment: start;
                        GlassButton { icon: "\u{E72B}"; label: @tr("Change device type"); clicked => { root.driver-action("platform"); } }
                    }
                }

                if root.screen == "android": AndroidVideoCard {
                    prefs: root.prefs;
                    hevc-ok: root.hevc-ok;
                    changed(p) => { root.changed(p); }
                }

                if root.screen != "android" && !root.studio: Card {
                    title: @tr("Auto unlock");
                    icon: "\u{E72E}";
                    tint-a: #a78bfa;
                    tint-b: #7c3aed;
                    info: @tr("Apple Driver mode only (not Studio mode). 3zT Mirroring wakes the iPhone/iPad, swipes up and types your passcode or password. It is stored encrypted (Windows DPAPI) for this Windows account only and never sent anywhere. Alt+U unlocks at any time.");
                    Text {
                        text: root.passcode-set ? @tr("A passcode is saved on this PC.") : @tr("No passcode saved yet.");
                        font-size: 12.5px;
                        font-weight: 600;
                        color: root.passcode-set ? Theme.ok : Theme.text-2;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        pc := Field {
                            placeholder: @tr("Device passcode or password");
                            input-type: InputType.password;
                            accepted => { root.save-passcode(self.text); self.text = ""; }
                        }
                        GlassButton {
                            primary: true;
                            label: @tr("Save");
                            enabled: pc.text != "";
                            clicked => { root.save-passcode(pc.text); pc.text = ""; }
                        }
                        if root.passcode-set: GlassButton {
                            label: @tr("Remove");
                            clicked => { root.save-passcode(""); }
                        }
                    }
                    Row {
                        label: @tr("Unlock when mirroring starts");
                        hint: @tr("Also Alt+U at any time");
                        Toggle { checked: prefs.auto-unlock; toggled(v) => { root.prefs.auto-unlock = v; root.changed(root.prefs); } }
                    }
                }

                if root.screen != "android": Card {
                    title: @tr("Connection & driver");
                    icon: "\u{E88E}";
                    tint-a: #34d399;
                    tint-b: #059669;
                    info: @tr("Apple Driver uses Apple's own driver. Studio mode uses libusb0 for high bitrate. Driver changes always ask for confirmation and administrator approval.");
                    Text { text: connection; font-size: 12.5px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
                    Text { text: driver-text; font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                    Row {
                        label: @tr("Connection");
                        Seg {
                            width: 170px;
                            options: ["wired", "wireless"];
                            labels: [@tr("Cable (USB)"), "Wi-Fi"];
                            value: root.link;
                            changed(v) => { root.set-link(v); }
                        }
                    }
                    Text {
                        text: root.mode == "usbdirect"
                            ? (root.link == "wireless" ? @tr("Wi-Fi: pick 3zT Mirroring in Screen Mirroring on the device.") : @tr("Cable: through the libusb0 driver, high bitrate."))
                            : (root.link == "wireless" ? @tr("Wi-Fi: press Set up Wi-Fi once with the cable in. A plugged-in device still works over the cable.") : @tr("Cable: through Apple's driver."));
                        font-size: 11px;
                        color: Theme.text-3;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        GlassButton { label: @tr("Change mode"); tip: @tr("Choose Apple Driver or Studio mode"); clicked => { root.driver-action("mode"); } }
                        GlassButton { label: @tr("Check drivers"); clicked => { root.driver-action("refresh"); } }
                        if !root.studio: GlassButton { label: @tr("Set up Wi-Fi"); clicked => { root.driver-action("wifi"); } }
                    }
                    if root.drv-filter || (root.drv-restore && !root.studio) || (root.drv-bind && root.studio): HorizontalLayout {
                        spacing: 6px;
                        if root.drv-filter: GlassButton { primary: true; label: @tr("Remove libusb0 filter"); clicked => { root.driver-action("removefilter"); } }
                        if root.drv-restore && !root.studio: GlassButton { label: @tr("Restore Apple driver"); clicked => { root.driver-action("restore"); } }
                        if root.drv-bind && root.studio: GlassButton { label: @tr("Install Studio mode driver"); clicked => { root.driver-action("bind"); } }
                    }
                }

                Card {
                    title: @tr("Updates");
                    icon: "\u{E895}";
                    tint-a: #34d399;
                    tint-b: #059669;
                    info: @tr("3zT Mirroring downloads only after you press Update, straight from the official GitHub release. It checks the file's SHA-256 and the release signature before running it. Your settings stay.");
                    Text { text: "3zT Mirroring v" + AppInfo.version; font-size: 12.5px; font-weight: 700; color: Theme.text; }
                    Row { label: @tr("Check at start"); Toggle { checked: prefs.update-check; toggled(v) => { root.prefs.update-check = v; root.changed(root.prefs); } } }
                    if root.upd-status != "": Text { text: root.upd-status; font-size: 11.5px; color: Theme.text-2; wrap: word-wrap; }
                    if root.upd-busy && root.upd-progress < 0: BusyBar { }
                    if root.upd-progress >= 0: Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.fill;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.upd-progress, 0, 1);
                            height: parent.height;
                            border-radius: 2px;
                            background: Theme.accent;
                            animate width { duration: 120ms; }
                        }
                    }
                    if root.upd-notes != "": Text { text: root.upd-notes; font-size: 11px; color: Theme.text-3; wrap: word-wrap; }
                    if root.upd-version != "": GlassButton {
                        primary: true;
                        enabled: !root.upd-busy;
                        label: (root.upd-switch ? @tr("Install v{}", root.upd-version) : @tr("Update to v{}", root.upd-version));
                        clicked => { root.update-action("install"); }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        GlassButton { enabled: !root.upd-busy; label: @tr("Check for updates"); clicked => { root.update-action("check"); } }
                        if root.upd-version != "": GlassButton { label: @tr("Release notes"); clicked => { root.update-action("notes"); } }
                    }
                }

                Card {
                    title: @tr("Advanced");
                    icon: "\u{E713}";
                    tint-a: #a1a1aa;
                    tint-b: #52525b;
                    Row { label: @tr("Start with Windows"); Toggle { checked: prefs.start-with-windows; toggled(v) => { root.prefs.start-with-windows = v; root.changed(root.prefs); } } }
                    Row { label: @tr("Close to the tray"); Toggle { checked: prefs.close-to-tray; toggled(v) => { root.prefs.close-to-tray = v; root.changed(root.prefs); } } }
                    Row { label: @tr("Always on top"); Toggle { checked: prefs.on-top; toggled(v) => { root.prefs.on-top = v; root.changed(root.prefs); } } }
                    Row { label: @tr("Stats in the header"); Toggle { checked: prefs.stats; toggled(v) => { root.prefs.stats = v; root.changed(root.prefs); } } }
                }

                Card {
                    title: @tr("Stats (measured)");
                    icon: "\u{E9D9}";
                    tint-a: #facc15;
                    tint-b: #ca8a04;
                    info: @tr("All numbers are measured: decoded fps, presented fps, skipped frames (replaced by a newer frame before display), last frame decode time.");
                    Text { text: stats-full; font-size: 11.5px; color: Theme.text-2; font-family: "Cascadia Mono"; wrap: word-wrap; }
                }
                Card {
                    title: @tr("Edge crop (fine)");
                    icon: "\u{E7A8}";
                    tint-a: #94a3b8;
                    tint-b: #64748b;
                    info: @tr("Trim black bars or borders off the picture, in device pixels. Touches still land in the right place.");
                    for side[i] in [
                        { key: "t", en: "Top" },
                        { key: "b", en: "Bottom" },
                        { key: "l", en: "Left" },
                        { key: "r", en: "Right" },
                    ]: VerticalLayout {
                        spacing: 2px;
                        property <float> v: side.key == "t" ? prefs.crop-t : side.key == "b" ? prefs.crop-b : side.key == "l" ? prefs.crop-l : prefs.crop-r;
                        Row {
                            label: (side.en);
                            Text { text: round(v) + " px"; font-size: 12px; color: Theme.text-2; vertical-alignment: center; }
                        }
                        GlassSlider {
                            maximum: 200;
                            step: 2;
                            value: v;
                            changed(x) => {
                                if side.key == "t" { root.prefs.crop-t = x; }
                                if side.key == "b" { root.prefs.crop-b = x; }
                                if side.key == "l" { root.prefs.crop-l = x; }
                                if side.key == "r" { root.prefs.crop-r = x; }
                                root.changed(root.prefs);
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        GlassButton {
                            label: @tr("Reset (0 px)");
                            clicked => {
                                root.prefs.crop-t = 0; root.prefs.crop-b = 0; root.prefs.crop-l = 0; root.prefs.crop-r = 0;
                                root.changed(root.prefs);
                            }
                        }
                    }
                }
                Card {
                    title: @tr("About & credits");
                    icon: "\u{E946}";
                    tint-a: #ec4899;
                    tint-b: #a855f7;
                    Text {
                        text: "3zT Mirroring v" + AppInfo.version;
                        font-size: 12.5px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    HorizontalLayout {
                        alignment: start;
                        GlassButton {
                            icon: "\u{E8B7}";
                            label: @tr("Open log folder");
                            tip: @tr("3zT Mirroring logs for bug reports (%LOCALAPPDATA%\\3zT Mirroring\\logs)");
                            clicked => { root.driver-action("logs"); }
                        }
                    }
                    Text {
                        text: @tr("© 2026 3zT · based on ZenLink © 2026 Zenvy Zenshiro · GPL-3.0-or-later · no warranty.");
                        font-size: 11px;
                        color: Theme.text-2;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Android: the scrcpy server (Genymobile & Romain Vimont, Apache-2.0) and Google's official adb (Android platform-tools, unmodified; NOTICE.txt in third_party). Apple: pymobiledevice3 (GPL-3.0), pane-iphone-mirror-windows (GPL-3.0), quicktime_video_hack (MIT), libusb-win32, UxPlay/playfair (GPL-3.0). AAC sound and the built-in HEVC decoder: FFmpeg (LGPL). Details: README and THIRD_PARTY_NOTICES.md.");
                        font-size: 11px;
                        color: Theme.text-2;
                        wrap: word-wrap;
                    }
                    Text {
                        text: @tr("Android is a trademark of Google LLC. iPhone, iPad and AirPlay are trademarks of Apple Inc. 3zT Mirroring is not affiliated with Google or Apple.");
                        font-size: 10.5px;
                        color: Theme.text-3;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// Android app launcher: a grid like the phone's app drawer, over
// the picture while a phone is mirrored (dock › Apps). The picture leaves its
// rectangle open (main.rs, VideoView::set_holes).
component AppLauncher inherits Rectangle {
    in property <bool> open;
    in property <string> title;
    in property <string> status;
    in property <bool> busy;
    in property <[AppRow]> apps;
    // Android 10+: an app can also open in its own window.
    in property <bool> window-ok;
    in-out property <string> open-in: "phone";
    in property <bool> searchable: true;
    callback filter(string);
    callback launch(int, string);
    callback close();
    border-radius: 22px;
    background: Theme.dark ? #18181cf5 : #f6f6f9f5;
    border-width: 0.75px;
    border-color: Theme.dark ? #ffffff24 : #0000001c;
    drop-shadow-blur: 24px;
    drop-shadow-offset-y: 8px;
    drop-shadow-color: #00000055;
    clip: true;
    property <float> t: root.open ? 1 : 0;
    animate t { duration: 220ms; easing: cubic-bezier(0.2, 0.9, 0.3, 1); }
    opacity: self.t;
    visible: self.t > 0.01;
    // Swallow clicks so nothing behind reacts.
    TouchArea { }
    VerticalLayout {
        y: 14px * (1 - root.t);
        padding: 16px;
        padding-bottom: 8px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Image { source: @image-url("../../../../assets/logo-256.png"); width: 22px; height: 22px; y: (parent.height - self.height) / 2; }
            Text { text: root.title; font-size: 14px; font-weight: 700; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            if root.window-ok: Seg {
                width: 210px;
                options: ["phone", "window"];
                labels: [@tr("On the phone"), @tr("New window")];
                value: root.open-in;
                changed(v) => { root.open-in = v; }
            }
            GlassButton { icon: "\u{E711}"; tip: @tr("Close"); clicked => { root.close(); } }
        }
        if !root.busy && root.searchable: Field {
            placeholder: @tr("Search apps…");
            edited(v) => { root.filter(v); }
        }
        if root.busy: BusyBar { }
        if root.status != "": Text { text: root.status; font-size: 11px; color: root.busy ? Theme.accent : Theme.text-3; wrap: word-wrap; }
        grid := Flickable {
            vertical-stretch: 1;
            property <int> cols: max(1, floor(self.width / 96px));
            property <length> cw: self.width / self.cols;
            content-height: ceil(root.apps.length / self.cols) * 100px;
            for a[i] in root.apps: Rectangle {
                x: mod(i, grid.cols) * grid.cw;
                y: floor(i / grid.cols) * 100px;
                width: grid.cw;
                height: 100px;
                border-radius: 16px;
                background: ta.pressed ? Theme.fill-hover.darker(10%) : ta.has-hover ? Theme.fill-hover : transparent;
                animate background { duration: 150ms; easing: ease-out; }
                ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.launch(i, root.window-ok ? root.open-in : "phone"); }
                }
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 12px + (ta.pressed ? 2px : 0px);
                    width: 50px;
                    height: 50px;
                    border-radius: 15px;
                    background: @linear-gradient(140deg, a.tint.brighter(18%) 0%, a.tint.darker(22%) 100%);
                    drop-shadow-blur: 8px;
                    drop-shadow-offset-y: 3px;
                    drop-shadow-color: a.tint.with-alpha(0.35);
                    animate y { duration: 90ms; }
                    Text { text: a.letter; font-size: 19px; font-weight: 750; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; }
                }
                Text {
                    x: 6px;
                    y: 68px;
                    width: parent.width - 12px;
                    height: 28px;
                    text: a.name;
                    font-size: 11px;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: top;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }
    }
}

// Shown in Settings › About (set from Cargo's version at start).
export global AppInfo {
    in property <string> version;
}

export component AppWindow inherits Window {
    title: @tr("3zT Mirroring");
    icon: @image-url("../../../../assets/logo-256.png");
    background: transparent;
    // Roomy start: taller, so the Android setup
    // card fits without scrolling (the header's own minimum sets the width,
    // 824 px at 100%). Rust shrinks it to the screen's work area on small
    // screens; the first frame refits it to the picture.
    preferred-width: 620px;
    preferred-height: 900px;
    // The header must fit; the clean view is only the picture.
    min-width: root.clean ? 160px : 520px;
    min-height: root.clean ? 160px : 420px;
    default-font-family: "Segoe UI Variable Text";

    in-out property <Prefs> prefs;
    in-out property <bool> settings-open: true; // Settings start open (docked at the side)
    in property <string> phase: "idle";
    in property <string> device;
    in property <string> link;
    in property <string> message;
    in property <string> stats-line;
    in property <string> stats-full;
    in property <string> driver-text;
    in property <string> connection;
    in property <bool> muted;
    in property <string> toast;
    // Connect card (see Placeholder).
    in property <int> flow-step: -1;
    in property <bool> flow-failed: false;
    in property <string> flow-kind: "apple";
    in property <bool> device-wifi: false;
    in property <string> device-need;
    callback flow-dismiss();
    callback need-fix();
    // Apple device list (connected + trusted before) and the AirPlay wait.
    in property <[AppleDev]> apple-devices;
    in property <bool> apple-listening;
    callback apple-pick(string);
    callback apple-forget(string);
    in property <bool> drv-restore;
    in property <bool> drv-bind;
    in property <bool> drv-filter;
    in property <bool> passcode-set;
    callback save-passcode(string);
    // Notice sheet (driver changes).
    in property <bool> sheet-open;
    in property <string> sheet-title;
    in property <string> sheet-body;
    in property <string> sheet-ok;
    in property <string> sheet-cancel;
    callback sheet-answer(bool);
    // Connection mode chooser (shown until a mode is chosen).
    in-out property <bool> chooser-open: false;
    in property <bool> chooser-cancelable: false;
    in property <string> mode-active;
    in property <string> mode-link: "wired";
    in property <bool> mode-remember: true;
    callback choose-mode(string, string, bool);
    callback set-link(string);
    // First screen and Android workspace: platform | apple | android.
    in-out property <string> screen: "platform";
    in property <bool> apple-detected;
    in property <int> android-count;
    in property <string> android-status;
    in property <[AndroidRow]> android-devices;
    // Android session: "idle", "connecting", "streaming", "error".
    in property <string> android-phase: "idle";
    in property <string> android-device;
    in property <string> android-link;
    in property <string> android-message;
    in property <bool> hevc-ok;
    callback android-start(int);
    callback android-start-via(int, string);
    in property <bool> android-wifi-busy;
    in property <string> android-wifi-status;
    callback android-wifi-device(int);
    callback android-wifi-connect(string);
    callback android-wifi-pair(string, string);
    in property <image> android-qr;
    in property <bool> android-qr-on;
    in property <string> android-qr-status;
    callback android-wifi-qr();
    callback android-wifi-qr-cancel();
    in property <bool> android-apps-open;
    in property <bool> android-apps-busy;
    in property <string> android-apps-title;
    in property <string> android-apps-status;
    in property <[AppRow]> android-apps;
    callback android-apps-filter(string);
    callback android-apps-close();
    in property <bool> android-apps-window-ok;
    // Files dragged over the window, and a running transfer (filedrop.rs).
    in property <bool> drop-hover;
    in property <bool> drop-ok;
    in property <bool> drop-apple;
    // iPhone/iPad: which app gets the dropped files (Apple Driver mode).
    in property <bool> files-open;
    in property <bool> files-busy;
    in property <string> files-title;
    in property <string> files-status;
    in property <[AppRow]> files-apps;
    callback files-pick(int);
    callback files-close();
    in property <string> transfer;
    in property <float> transfer-p: -1;
    out property <length> transfer-w: min(self.width - 40px, 360px);
    callback android-app-launch(int, string);
    // Launcher rectangle (logical px), kept open in the picture by Rust.
    out property <length> launcher-x: root.stage-x + 10px;
    out property <length> launcher-y: root.stage-y + 10px;
    out property <length> launcher-w: max(0px, root.stage-w - 20px);
    out property <length> launcher-h: max(0px, root.stage-h - 20px);
    callback android-stop();
    callback android-restart();
    property <bool> on-android: root.screen == "android";
    // A picture is on the stage (either platform).
    property <bool> picture: root.on-android ? root.android-phase == "streaming" : root.phase == "streaming";
    callback choose-platform(string, bool);
    callback change-platform();
    // Animated dot field (rendered in Rust) and the cursor over the stage.
    in property <image> dots-image;
    out property <bool> stage-hover: stage-ta.has-hover;
    out property <length> stage-mouse-x: stage-ta.mouse-x;
    out property <length> stage-mouse-y: stage-ta.mouse-y;

    // Where the native video view goes (logical px). Read by Rust.
    out property <length> stage-x: stage.absolute-position.x;
    // Toast and tooltip rectangles: the picture (a child window) leaves
    // them open, else it would cover them (main.rs, VideoView::set_holes).
    out property <bool> tip-on: tip.visible;
    out property <length> tip-x: tip.x;
    out property <length> tip-y: tip.y;
    out property <length> tip-w: tip.width;
    out property <length> tip-h: tip.height;
    out property <length> toast-w: min(self.width - 40px, toast-measure.preferred-width + 32px);
    out property <length> stage-y: stage.absolute-position.y;
    out property <length> stage-w: stage.width;
    out property <length> stage-h: stage.height;
    // Everything around the picture: paddings, bars, settings.
    // Settings slide: 0 = closed, 1 = open. Spring-like ease-out (fast start,
    // soft landing), shared by the panel and the window width in Rust.
    // Settings slide progress, 0 = closed, 1 = open. Driven from Rust on the
    // same tick as the window width: a Slint animation ran ahead of
    // the window by a frame and the picture jumped while the panel slid.
    in property <float> sp: 1;
    // Materialize curves (shayann07/liquidglass, Apache-2.0): in 320 ms,
    // out 240 ms.
    // Clean view: while a picture is shown, the window is only the picture.
    // F2 brings the header and the dock back (around the picture, never on
    // top of it) and hides them again.
    in-out property <bool> bars-hidden: true;
    in property <bool> has-frame;
    out property <bool> clean: root.picture && root.has-frame && root.bars-hidden && !root.sheet-open && !root.chooser-open && root.screen != "platform";
    property <bool> dock: root.on-android || root.mode-active != "usbdirect";
    out property <length> chrome-w: root.clean ? 0px : 16px + 368px * sp;
    out property <length> chrome-h: root.clean ? 0px : 16px + 46px + 8px + (root.dock ? 8px + 46px : 0px);

    callback start-cast();
    callback stop-cast();
    callback restart();
    callback prefs-changed(Prefs);
    callback action(string);
    callback driver-action(string);
    in property <string> upd-status;
    in property <string> upd-version;
    in property <string> upd-notes;
    in property <bool> upd-switch;
    in property <bool> upd-busy;
    in property <float> upd-progress: -1;
    in property <string> upd-channel-own: "beta";
    callback update-action(string);
    callback settings-toggled(bool);
    callback window-action(string);
    // A key press for the device (Android); true = it was sent.
    callback key-input(string, bool, bool, bool) -> bool;
    public function focus-keys() { keys.focus(); }
    no-frame: true;
    forward-focus: keys;

    // Narrow window: icon-only buttons. Set from Rust (window width), not
    // from layout, so the layout cannot feed back into it.
    in property <bool> compact: false;
    in property <bool> is-maximized: false;
    in property <bool> fullscreen: false;
    // Picture column too narrow for labelled shortcuts.
    in property <bool> compact-bar: false;
    // Full screen / maximised: square edges to the screen border (no
    // rounded corners showing the desktop, no resize strips).
    property <bool> edge: root.fullscreen || root.is-maximized;
    // F11 toggles full screen, Esc leaves it.
    keys := FocusScope {
        key-pressed(ev) => {
            if ev.text == Key.F11 { root.window-action("fullscreen"); return accept; }
            if ev.text == Key.F2 && root.picture { root.bars-hidden = !root.bars-hidden; root.window-action("bars"); return accept; }
            if ev.text == Key.Escape && root.fullscreen { root.window-action("fullscreen"); return accept; }
            if root.key-input(ev.text, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt) { return accept; }
            reject
        }
    }
    Rectangle {
        // Full screen has nothing behind the glass (Windows shows grey or
        // black there): solid theme colour instead, so light stays light.
        background: root.clean ? #000000 : root.fullscreen ? (Theme.dark ? #161618 : #f2f2f7) : Theme.base;
        border-radius: root.edge || root.clean ? 0px : 12px;
        clip: true;
        VerticalLayout {
            padding: root.clean ? 0px : 8px;
            spacing: root.clean ? 0px : 8px;
            if !root.clean: TopBar {
                compact: root.compact;
                maximized: root.is-maximized;
                fullscreen: root.fullscreen;
                device: root.screen == "apple" ? root.device : root.on-android ? root.android-device : "";
                phase: root.screen == "apple" ? root.phase : root.on-android ? root.android-phase : "idle";
                link: root.screen == "apple" ? root.link : root.on-android ? root.android-link : "";
                need: root.screen == "apple" ? root.device-need : "";
                listening: root.screen == "apple" && root.apple-listening;
                stats: root.prefs.stats ? root.stats-line : "";
                settings-open: root.settings-open;
                muted: root.muted;
                fit: root.prefs.fit;
                upd-version: root.upd-switch ? "" : root.upd-version;
                upd-busy: root.upd-busy;
                upd-progress: root.upd-progress;
                update-now => { root.update-action("install"); }
                window-action(a) => { root.window-action(a); }
                start => {
                    if root.screen == "apple" { root.start-cast(); }
                    if root.on-android { root.android-start(-1); }
                }
                stop => {
                    if root.on-android { root.android-stop(); } else { root.stop-cast(); }
                }
                restart => {
                    if root.screen == "apple" { root.restart(); }
                    if root.on-android { root.android-restart(); }
                }
                settings => {
                    root.settings-open = !root.settings-open;
                    root.settings-toggled(root.settings-open);
                }
                mute => { root.action("mute"); }
                rotate => { root.action("rotate"); }
                fit-next => {
                    root.prefs.fit = root.prefs.fit == "contain" ? "cover" : root.prefs.fit == "cover" ? "fill" : "contain";
                    root.prefs-changed(root.prefs);
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: root.clean ? 0px : 8px;
                    stage := Rectangle {
                        vertical-stretch: 1;
                        border-radius: root.clean ? 0px : 22px;
                        background: root.clean ? #000000 : root.picture ? Theme.stage : Theme.panel;
                        border-width: root.clean ? 0px : 1px;
                        border-color: Theme.edge;
                        clip: true;
                        stage-ta := TouchArea { }
                        if !root.picture && root.prefs.dots: Image {
                            source: root.dots-image;
                            width: parent.width;
                            height: parent.height;
                            image-fit: fill;
                        }
                        if root.on-android && root.android-phase != "streaming": AndroidHome {
                            status: root.android-status;
                            devices: root.android-devices;
                            phase: root.android-phase;
                            message: root.android-message;
                            prefs: root.prefs;
                            hevc-ok: root.hevc-ok;
                            prefs-changed(p) => { root.prefs = p; root.prefs-changed(p); }
                            back => { root.change-platform(); }
                            start-device(i) => { root.android-start(i); }
                            start-device-via(i, v) => { root.android-start-via(i, v); }
                            wifi-busy: root.android-wifi-busy;
                            wifi-status: root.android-wifi-status;
                            wifi-device(i) => { root.android-wifi-device(i); }
                            wifi-connect(a) => { root.android-wifi-connect(a); }
                            wifi-pair(a, c) => { root.android-wifi-pair(a, c); }
                            qr-image: root.android-qr;
                            qr-on: root.android-qr-on;
                            qr-status: root.android-qr-status;
                            wifi-qr => { root.android-wifi-qr(); }
                            wifi-qr-cancel => { root.android-wifi-qr-cancel(); }
                        }
                        if root.screen == "apple" && root.phase != "streaming": Placeholder {
                            phase: root.phase;
                            device: root.device;
                            message: root.message;
                            flow-step: root.flow-step;
                            flow-failed: root.flow-failed;
                            flow-kind: root.flow-kind;
                            wifi: root.device-wifi;
                            need: root.device-need;
                            mode: root.mode-active;
                            link: root.mode-link;
                            set-link(l) => { root.set-link(l); }
                            change-mode => { root.driver-action("mode"); }
                            fix => { root.need-fix(); }
                            devices: root.apple-devices;
                            listening: root.apple-listening;
                            pick(id) => { root.apple-pick(id); }
                            forget(id) => { root.apple-forget(id); }
                            stop => { root.stop-cast(); }
                            start => { root.start-cast(); }
                            dismiss => { root.flow-dismiss(); }
                        }
                    }
                    if !root.clean && root.dock: BottomBar {
                        compact: root.compact-bar;
                        android: root.on-android;
                        action(a) => { root.action(a); }
                    }
                }
                // Slides in from the right edge while the window grows.
                if root.sp > 0.001 && !root.clean: Rectangle {
                    width: 368px * root.sp;
                    clip: true;
                    SettingsPanel {
                    x: 8px + (1 - root.sp) * 28px;
                    width: 360px;
                    height: parent.height;
                    opacity: min(1, root.sp * 1.6);
                    prefs: root.prefs;
                    driver-text: root.driver-text;
                    connection: root.connection;
                    link: root.mode-link;
                    mode: root.mode-active;
                    screen: root.screen;
                    drv-restore: root.drv-restore;
                    drv-bind: root.drv-bind;
                    drv-filter: root.drv-filter;
                    set-link(l) => { root.set-link(l); }
                    stats-full: root.stats-full;
                    hevc-ok: root.hevc-ok;
                    changed(p) => { root.prefs = p; root.prefs-changed(p); }
                    close => { root.settings-open = false; root.settings-toggled(false); }
                    driver-action(a) => { root.driver-action(a); }
                    upd-status: root.upd-status;
                    upd-version: root.upd-version;
                    upd-notes: root.upd-notes;
                    upd-switch: root.upd-switch;
                    upd-busy: root.upd-busy;
                    upd-progress: root.upd-progress;
                    upd-channel-own: root.upd-channel-own;
                    update-action(a) => { root.update-action(a); }
                    passcode-set: root.passcode-set;
                    save-passcode(c) => { root.save-passcode(c); }
                    }
                }
            }
        }
        // Resize from every edge and corner (no system frame).
        for e in [
            { id: "n", x: 10px, y: 0px, w: -20px, h: 5px, c: MouseCursor.ns-resize },
            { id: "s", x: 10px, y: -5px, w: -20px, h: 5px, c: MouseCursor.ns-resize },
            { id: "w", x: 0px, y: 10px, w: 5px, h: -20px, c: MouseCursor.ew-resize },
            { id: "e", x: -5px, y: 10px, w: 5px, h: -20px, c: MouseCursor.ew-resize },
            { id: "nw", x: 0px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
            { id: "se", x: -10px, y: -10px, w: 10px, h: 10px, c: MouseCursor.nwse-resize },
            { id: "ne", x: -10px, y: 0px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
            { id: "sw", x: 0px, y: -10px, w: 10px, h: 10px, c: MouseCursor.nesw-resize },
        ]: TouchArea {
            enabled: !root.edge;
            x: e.x < 0 ? parent.width + e.x : e.x;
            y: e.y < 0 ? parent.height + e.y : e.y;
            width: e.w < 0 ? parent.width + e.w : e.w;
            height: e.h < 0 ? parent.height + e.h : e.h;
            mouse-cursor: e.c;
            pointer-event(ev) => {
                if ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left {
                    root.window-action("resize-" + e.id);
                }
            }
        }
        if root.screen == "platform": PlatformSelector {
            width: parent.width;
            height: parent.height;
            border-radius: root.edge ? 0px : 12px;
            picked: root.prefs.platform;
            remember: root.prefs.remember-platform;
            apple-detected: root.apple-detected;
            android-count: root.android-count;
            prefs: root.prefs;
            prefs-changed(p) => { root.prefs = p; root.prefs-changed(p); }
            choose(p, r) => { root.choose-platform(p, r); }
        }
        if root.chooser-open && root.screen == "apple": ModeChooser {
            width: parent.width;
            height: parent.height;
            border-radius: root.edge ? 0px : 12px;
            cancelable: root.chooser-cancelable;
            active: root.mode-active;
            link: root.mode-link;
            remember: root.mode-remember;
            prefs: root.prefs;
            prefs-changed(p) => { root.prefs = p; root.prefs-changed(p); }
            choose(m, l, r) => { root.chooser-open = false; root.choose-mode(m, l, r); }
            cancel => { root.chooser-open = false; }
            back => { root.change-platform(); }
        }
        if root.sheet-open: NoticeSheet {
            width: parent.width;
            height: parent.height;
            border-radius: root.edge ? 0px : 12px;
            title: root.sheet-title;
            body: root.sheet-body;
            ok: root.sheet-ok;
            cancel: root.sheet-cancel;
            answer(yes) => { root.sheet-answer(yes); }
        }
        // Hover tooltip: below the control, or above it near the bottom.
        tip := Rectangle {
            property <bool> above: Tip.bottom + 40px > root.height;
            width: min(tipT.preferred-width + 20px, 280px);
            height: tipT.preferred-height + 12px;
            x: max(8px, min(root.width - self.width - 8px, Tip.x - self.width / 2));
            y: above ? Tip.top - self.height - 6px : Tip.bottom + 6px;
            border-radius: 9px;
            background: Theme.dark ? #26283af2 : #ffffffee;
            border-width: 1px;
            border-color: Theme.line;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: #0000003a;
            opacity: Tip.shown ? 1 : 0;
            visible: self.opacity > 0.01;
            animate opacity { delay: Tip.shown ? 350ms : 0ms; duration: 120ms; }
            tipT := Text {
                text: Tip.text;
                font-size: 11.5px;
                color: Theme.text;
                wrap: word-wrap;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width - 20px;
            }
        }
        AppLauncher {
            x: root.launcher-x;
            y: root.launcher-y;
            width: root.launcher-w;
            height: root.launcher-h;
            open: root.android-apps-open && root.on-android;
            title: root.android-apps-title;
            status: root.android-apps-status;
            busy: root.android-apps-busy;
            apps: root.android-apps;
            window-ok: root.android-apps-window-ok;
            filter(v) => { root.android-apps-filter(v); }
            launch(i, where) => { root.android-app-launch(i, where); }
            close => { root.android-apps-close(); }
        }
        // iPhone/iPad: pick the app that receives the dropped files.
        AppLauncher {
            x: root.launcher-x;
            y: root.launcher-y;
            width: root.launcher-w;
            height: root.launcher-h;
            open: root.files-open;
            title: root.files-title;
            status: root.files-status;
            busy: root.files-busy;
            apps: root.files-apps;
            window-ok: false;
            searchable: false;
            launch(i, where) => { root.files-pick(i); }
            close => { root.files-close(); }
        }
        // Files dragged in from Explorer.
        Rectangle {
            x: root.launcher-x;
            y: root.launcher-y;
            width: root.launcher-w;
            height: root.launcher-h;
            border-radius: 22px;
            property <float> t: root.drop-hover ? 1 : 0;
            animate t { duration: 160ms; easing: ease-out; }
            opacity: self.t;
            visible: self.t > 0.01;
            background: Theme.dark ? #101014ee : #f4f4f8ee;
            border-width: 2px;
            border-color: root.drop-ok ? Theme.accent : Theme.warn;
            VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding: 24px;
                Text {
                    text: root.drop-ok ? "\u{E898}" : "\u{E7BA}";
                    font-family: Theme.icons;
                    font-size: 40px;
                    color: root.drop-ok ? Theme.accent : Theme.warn;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.drop-ok ? @tr("Drop to send to the device") : root.drop-apple ? @tr("Sending files needs Apple Driver mode") : @tr("No Android phone is being mirrored");
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.drop-apple
                        ? (root.drop-ok ? @tr("Then pick the app on the iPhone/iPad (e.g. VLC, Documents). The file also shows in Files › On My iPhone.")
                                        : @tr("Studio mode replaces Apple's USB driver, so it cannot send files. Switch to Apple Driver in Settings."))
                        : root.drop-ok ? @tr("An .apk file is installed. Other files go to the phone's Download folder.") : @tr("Start mirroring an Android phone, then drop files here.");
                    font-size: 12px;
                    color: Theme.text-2;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
        // File transfer progress, above the toast.
        if root.transfer != "": Glass {
            strong: true;
            x: (parent.width - self.width) / 2;
            y: parent.height - 150px;
            width: root.transfer-w;
            height: 40px;
            border-radius: 13px;
            VerticalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 7px;
                padding-bottom: 7px;
                spacing: 5px;
                Text { text: root.transfer; font-size: 12px; color: Theme.text; overflow: elide; horizontal-alignment: center; }
                Rectangle {
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.fill;
                    clip: true;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.transfer-p, 0, 1);
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.accent;
                        animate width { duration: 120ms; }
                    }
                }
            }
        }
        toast-measure := Text { text: root.toast; font-size: 12.5px; visible: false; }
        if root.toast != "": Glass {
            strong: true;
            x: (parent.width - self.width) / 2;
            property <float> t: 0;
            init => { self.t = 1; }
            animate t { duration: 420ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
            opacity: self.t;
            y: parent.height - 104px + 16px * (1 - self.t); // above the dock, rises in
            width: root.toast-w;
            height: 36px;
            border-radius: 12px;
            toastT := Text { text: root.toast; font-size: 12.5px; color: Theme.text; }
        }
    }
}
